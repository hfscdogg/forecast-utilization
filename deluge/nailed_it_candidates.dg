List nailed_it_candidates(int max_count)
{
    // "Nailed It" photo candidates for the Monday actuals email, newest
    // first. Python mirror: nailed_it.py (parse_photo_description,
    // is_candidate, select_candidates). Keep in sync.
    //
    // Sources (Henry 2026-11-06: "focus on getting it right now"): two
    // Drive folders, each read one level deep (the root plus its direct
    // subfolders), so the YYYY-MM or year layout underneath can change
    // without touching this code.
    //   1. "Livewire Job Photos" (Henry's My Drive), filled hourly by the
    //      Zoho CRM sync copyMeetingPhotosToDrive. Those files have no
    //      description; they are eligible on their file name,
    //        YYYY-MM-DD_Deal####_Client_Installer_xxxxxx.ext
    //      which also gives the client (job_name) and the crew (sent_by).
    //   2. Brand Library > Job Photos, the older upload form. Its photos
    //      are eligible only when the description says Finished and the
    //      customer OK'd sharing:
    //        Job: Block Party
    //        Sent by: brianredden@getlivewire.com
    //        What did we install? Event
    //        Where is the job at? Finished
    //        Is the customer OK with us sharing these? Yes, they said OK
    //      Some labels have no separator at all ("Job or event name
    //      Clifford"), so lines are matched by label prefix.
    //
    // Eligible: an image, created within the last PHOTO_MAX_AGE_DAYS, from
    // the sync (by name) or marked Finished + consent (by description), and
    // never used in a sent email (Nailed_It_Photos, Status "Used").
    //
    // Needs the Creator connection "google_drive" (Google Drive service,
    // scope https://www.googleapis.com/auth/drive), authorized by a
    // Google account that can read both folders.
    PHOTO_ROOT_FOLDER_IDS = {"1lKMpk79F3h69bODbW7bRR0WTvkFwp78L", "1EgXWaKto9U39GNwNNS7mCkZR0LpBhTFO"};
    PHOTO_MAX_AGE_DAYS = 30;
    // Deluge has no while loop: iterate a fixed page budget instead.
    PAGE_BUDGET = {1, 2, 3, 4, 5};
    // Interim source (Henry 2026-11-04: "grab some finished photos from
    // our website to use for now") until the Zoho CRM photo sync lands.
    // Hand-picked finished installs from getlivewire.com: no faces, no
    // stock or rendered images. Already public, so nailed_it_share passes
    // them through; the URL doubles as the photo id. They come after the
    // library photos and are exempt from the 30-day age limit. Mirrors
    // WEBSITE_PHOTOS in nailed_it.py.
    WEBSITE_PHOTOS = {
        {"url": "https://www.getlivewire.com/wp-content/uploads/2023/05/CommercialAV-1.jpg", "job_name": "Boardroom display and conferencing", "installed": "Commercial AV"},
        {"url": "https://www.getlivewire.com/wp-content/uploads/2023/05/CommercialAV.jpg", "job_name": "Office lounge display", "installed": "Commercial AV"},
        {"url": "https://www.getlivewire.com/wp-content/uploads/2023/06/Commercial_Technology_Spaces_38.jpg", "job_name": "Conference room display", "installed": "Commercial AV"},
        {"url": "https://www.getlivewire.com/wp-content/uploads/2023/07/CommonHouseLandingThumb-e1761073657367.jpg", "job_name": "Common House Richmond screening room", "installed": "Projection and audio"},
        {"url": "https://www.getlivewire.com/wp-content/uploads/2023/05/DistributedAVinOffice.jpg", "job_name": "Office conference room", "installed": "Distributed AV"},
        {"url": "https://www.getlivewire.com/wp-content/uploads/2022/02/ExteriorLighting2.jpg", "job_name": "Exterior home lighting", "installed": "Lighting"},
        {"url": "https://www.getlivewire.com/wp-content/uploads/2023/05/Home-Theater-Solutions.jpg", "job_name": "Custom home theater", "installed": "Home theater"},
        {"url": "https://www.getlivewire.com/wp-content/uploads/2023/05/SmartKitchen_Web.jpg", "job_name": "Kitchen pendant and recessed lighting", "installed": "Lighting"},
        {"url": "https://www.getlivewire.com/wp-content/uploads/2022/12/WiringCloset.jpg", "job_name": "Labeled network and AV terminations", "installed": "Structured wiring"},
        {"url": "https://www.getlivewire.com/wp-content/uploads/2023/05/commercial-av-systems1.jpg", "job_name": "Meeting hall projection", "installed": "Commercial AV"},
        {"url": "https://www.getlivewire.com/wp-content/uploads/2026/06/livewire-how-room.jpg", "job_name": "Sanctuary speaker arrays and projection", "installed": "House of worship AV"}
    };

    used_ids = List();
    used_recs = Nailed_It_Photos[Status == "Used"];
    for each u in used_recs
    {
        used_ids.add(u.File_ID);
    }

    cutoff = zoho.currenttime.subDay(PHOTO_MAX_AGE_DAYS).toString("yyyy-MM-dd'T'HH:mm:ss");

    candidates = List();
    page_token = "";
    keep_going = true;
    // The Drive library is optional while the google_drive connection is
    // being set up: a failed listing falls through to the website photos.
    try
    {
    // Parent clause: each root folder plus its direct subfolders.
    parent_clause = "";
    for each root_id in PHOTO_ROOT_FOLDER_IDS
    {
        parent_clause = parent_clause + "'" + root_id + "' in parents or ";
        sub_params = Map();
        sub_params.put("q", "'" + root_id + "' in parents and mimeType = 'application/vnd.google-apps.folder' and trashed = false");
        sub_params.put("pageSize", "200");
        sub_params.put("supportsAllDrives", "true");
        sub_params.put("includeItemsFromAllDrives", "true");
        sub_params.put("fields", "files(id,name)");
        sub_resp = invokeurl
        [
            url: "https://www.googleapis.com/drive/v3/files"
            type: GET
            parameters: sub_params
            connection: "google_drive"
        ];
        sub_folders = sub_resp.get("files");
        if(sub_folders != null)
        {
            for each sf in sub_folders
            {
                parent_clause = parent_clause + "'" + sf.get("id") + "' in parents or ";
            }
        }
    }
    parent_clause = parent_clause.subString(0, parent_clause.length() - 4);
    q = "(" + parent_clause + ") and trashed = false and mimeType contains 'image/' and createdTime > '" + cutoff + "'";
    for each pg in PAGE_BUDGET
    {
        if(keep_going)
        {
            params = Map();
            params.put("q", q);
            params.put("orderBy", "createdTime desc");
            params.put("pageSize", "100");
            params.put("supportsAllDrives", "true");
            params.put("includeItemsFromAllDrives", "true");
            params.put("fields", "nextPageToken,files(id,name,description,createdTime,webViewLink,thumbnailLink)");
            if(page_token != "")
            {
                params.put("pageToken", page_token);
            }
            resp = invokeurl
            [
                url: "https://www.googleapis.com/drive/v3/files"
                type: GET
                parameters: params
                connection: "google_drive"
            ];
            files = resp.get("files");
            if(files != null)
            {
                for each f in files
                {
                    if(candidates.size() < max_count && !used_ids.contains(f.get("id")))
                    {
                        desc = f.get("description");
                        if(desc == null)
                        {
                            desc = "";
                        }
                        job = "";
                        event_name = "";
                        sent_by = "";
                        installed = "";
                        stage = "";
                        consent = "";
                        for each raw in desc.toList("\n")
                        {
                            line = raw.trim();
                            // Longest labels first so "Job or event name" is
                            // not swallowed by "Job:".
                            if(line.startsWith("Is the customer OK with us sharing these?"))
                            {
                                consent = line.subString(41, line.length()).trim();
                            }
                            else if(line.startsWith("What did we install?"))
                            {
                                installed = line.subString(20, line.length()).trim();
                            }
                            else if(line.startsWith("Where is the job at?"))
                            {
                                stage = line.subString(20, line.length()).trim();
                            }
                            else if(line.startsWith("Job or event name"))
                            {
                                event_name = line.subString(17, line.length()).trim();
                            }
                            else if(line.startsWith("Sent by:"))
                            {
                                sent_by = line.subString(8, line.length()).trim();
                            }
                            else if(line.startsWith("Job:"))
                            {
                                job = line.subString(4, line.length()).trim();
                            }
                        }
                        job_name = event_name;
                        if(job_name == "" && job.toLowerCase() != "job" && job.toLowerCase() != "event")
                        {
                            job_name = job;
                        }
                        eligible = stage.toLowerCase().startsWith("finished") && consent.toLowerCase().startsWith("yes");
                        // CRM sync file: YYYY-MM-DD_Deal####_Client_Installer_xxxxxx.ext
                        fname = f.get("name");
                        if(fname == null)
                        {
                            fname = "";
                        }
                        if(fname.matches("^\\d{4}-\\d{2}-\\d{2}_Deal\\w+_[A-Za-z0-9-]*_[A-Za-z0-9-]*_[A-Za-z0-9]+\\.[A-Za-z0-9]+$"))
                        {
                            eligible = true;
                            name_parts = fname.toList("_");
                            deal_part = name_parts.get(1);
                            client_part = name_parts.get(2);
                            crew_part = name_parts.get(3);
                            job_name = "";
                            if(client_part != "UnknownClient")
                            {
                                job_name = client_part.replaceAll("([a-z0-9])([A-Z])", "$1 $2");
                            }
                            sent_by = "";
                            if(crew_part != "UnknownInstaller")
                            {
                                sent_by = crew_part.replaceAll("([a-z0-9])([A-Z])", "$1 $2");
                            }
                            installed = "";
                            if(deal_part != "DealUnknown")
                            {
                                installed = "Deal " + deal_part.subString(4, deal_part.length());
                            }
                        }
                        if(eligible)
                        {
                            c = Map();
                            c.put("id", f.get("id"));
                            c.put("name", f.get("name"));
                            c.put("job_name", job_name);
                            c.put("sent_by", sent_by);
                            c.put("installed", installed);
                            c.put("created", f.get("createdTime"));
                            c.put("view_url", f.get("webViewLink"));
                            c.put("thumb_url", f.get("thumbnailLink"));
                            candidates.add(c);
                        }
                    }
                }
            }
            next_token = resp.get("nextPageToken");
            if(candidates.size() >= max_count || next_token == null || next_token == "")
            {
                keep_going = false;
            }
            else
            {
                page_token = next_token;
            }
        }
    }
    }
    catch (drive_err)
    {
        info "nailed_it_candidates: Drive library skipped: " + drive_err;
    }

    for each w in WEBSITE_PHOTOS
    {
        if(candidates.size() < max_count && !used_ids.contains(w.get("url")))
        {
            c = Map();
            c.put("id", w.get("url"));
            c.put("name", w.get("url").getSuffix("/uploads/"));
            c.put("job_name", w.get("job_name"));
            c.put("sent_by", "getlivewire.com");
            c.put("installed", w.get("installed"));
            c.put("created", "");
            c.put("view_url", w.get("url"));
            c.put("thumb_url", w.get("url"));
            candidates.add(c);
        }
    }
    return candidates;
}
