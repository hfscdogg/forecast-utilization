void write_forecast_history(Map result, String run_id)
{
    techs = result.get("techs");
    week_start_str = result.get("week_start");
    week_end_str = result.get("week_end");
    generated_at = zoho.currenttime;

    week_start_date = week_start_str.toDate();
    week_end_date = week_end_str.toDate();

    for each r in techs
    {
        unknown_csv = "";
        unknowns = r.get("unknown_event_types");
        if(unknowns != null && unknowns.size() > 0)
        {
            unknown_csv = unknowns.toString(", ");
        }

        notes_parts = List();
        if(r.get("training_hours") > 0)
        {
            notes_parts.add(r.get("training_hours") + " training hours");
        }
        if(r.get("non_billable_hours") > 0)
        {
            notes_parts.add(r.get("non_billable_hours") + " non-billable hours");
        }
        if(r.get("drive_time_adder") > 0)
        {
            notes_parts.add(r.get("drive_time_adder") + " drive-time adder");
        }
        if(r.get("training_drove_ot"))
        {
            notes_parts.add("training drove OT");
        }
        if(unknown_csv != "")
        {
            notes_parts.add("unknown event types: " + unknown_csv);
        }
        notes_text = "";
        for each p in notes_parts
        {
            if(notes_text != "")
            {
                notes_text = notes_text + "; ";
            }
            notes_text = notes_text + p;
        }

        // Native Deluge insert-into. zoho.creator.createRecord on this
        // tenant requires the 6-arg signature (scope + connection); the
        // 4-arg form errors with "mandatory params '6'". insert-into runs
        // in the function's own auth context, no connection needed.
        insert into Utilization_Forecast_History
        [
            Run_ID = run_id
            Forecast_Generated_At = generated_at
            Forecast_Week_Start = week_start_date
            Forecast_Week_End = week_end_date
            Technician = r.get("technician")
            Billable_Hours_Scheduled = r.get("billable_hours_scheduled")
            Hours_Scheduled = r.get("hours_scheduled")
            Non_Billable_Hours = r.get("non_billable_hours")
            Training_Hours = r.get("training_hours")
            Drive_Time_Adder = r.get("drive_time_adder")
            Forecast_OT = r.get("forecast_ot")
            Forecast_Hours = r.get("forecast_hours")
            Forecast_Utilization = r.get("forecast_utilization")
            Training_Drove_OT = r.get("training_drove_ot")
            Notes = notes_text
            Unknown_Event_Types = unknown_csv
            Source_Events_Count = r.get("source_events_count")
        ];
    }
}
