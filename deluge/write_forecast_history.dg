void write_forecast_history(Map result, String run_id)
{
    techs = result.get("techs");
    week_start_str = result.get("week_start");
    week_end_str = result.get("week_end");
    generated_at = zoho.currenttime;

    week_start_date = week_start_str.toDate();
    week_end_date = week_end_str.toDate();

    for each r in techs
    {
        unknown_csv = "";
        unknowns = r.get("unknown_event_types");
        if(unknowns != null && unknowns.size() > 0)
        {
            unknown_csv = unknowns.toString(", ");
        }

        notes_parts = List();
        if(r.get("training_hours") > 0)
        {
            notes_parts.add(r.get("training_hours") + " training hours");
        }
        if(r.get("non_billable_hours") > 0)
        {
            notes_parts.add(r.get("non_billable_hours") + " non-billable hours");
        }
        if(r.get("drive_time_adder") > 0)
        {
            notes_parts.add(r.get("drive_time_adder") + " drive-time adder");
        }
        if(r.get("training_drove_ot"))
        {
            notes_parts.add("training drove OT");
        }
        if(unknown_csv != "")
        {
            notes_parts.add("unknown event types: " + unknown_csv);
        }
        notes_text = "";
        for each p in notes_parts
        {
            if(notes_text != "")
            {
                notes_text = notes_text + "; ";
            }
            notes_text = notes_text + p;
        }

        record = Map();
        record.put("Run_ID", run_id);
        record.put("Forecast_Generated_At", generated_at);
        record.put("Forecast_Week_Start", week_start_date);
        record.put("Forecast_Week_End", week_end_date);
        record.put("Technician", r.get("technician"));
        record.put("Billable_Hours_Scheduled", r.get("billable_hours_scheduled"));
        record.put("Hours_Scheduled", r.get("hours_scheduled"));
        record.put("Non_Billable_Hours", r.get("non_billable_hours"));
        record.put("Training_Hours", r.get("training_hours"));
        record.put("Drive_Time_Adder", r.get("drive_time_adder"));
        record.put("Forecast_OT", r.get("forecast_ot"));
        record.put("Forecast_Hours", r.get("forecast_hours"));
        record.put("Forecast_Utilization", r.get("forecast_utilization"));
        record.put("Training_Drove_OT", r.get("training_drove_ot"));
        record.put("Notes", notes_text);
        record.put("Unknown_Event_Types", unknown_csv);
        record.put("Source_Events_Count", r.get("source_events_count"));

        insert_resp = zoho.creator.createRecord(
            "hfsclifford",
            "forecast-utilization",
            "Utilization_Forecast_History",
            record
        );
        info insert_resp;
    }
}
