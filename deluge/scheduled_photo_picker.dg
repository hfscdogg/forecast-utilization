void scheduled_photo_picker()
{
    // Sunday 4pm ET, 24 hours before scheduled_actuals (Monday 4pm ET).
    // Emails Henry up to MAX_CANDIDATES eligible "Nailed It" photos from
    // the asset library (nailed_it_candidates.dg), each with a "Use this
    // one" link to the pick_nailed_photo Custom API.
    //
    // No pick by Monday's run: send_actuals_email falls back to the
    // newest eligible photo, so the email never waits on this.
    PICKER_TO = "henry@getlivewire.com";
    PICKER_FROM = "henry@getlivewire.com";
    MAX_CANDIDATES = 6;
    INK = "#1A1A1A";
    TEXT_SECONDARY = "#6B6B60";
    COPPER = "#F7941D";
    CARD_BORDER = "#E5E5E0";
    SANS = "-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif";

    try
    {
        candidates = thisapp.nailed_it_candidates(MAX_CANDIDATES);
        pick_api = thisapp.Variables.NAILED_IT_PICK_API_URL;
        joiner = "?";
        if(pick_api.contains("?"))
        {
            joiner = "&";
        }

        if(candidates.size() == 0)
        {
            body = "<p style='font-family:" + SANS + ";font-size:14px;'>No eligible Nailed It photos this week: nothing in the asset library from the last 30 days is marked <strong>Finished</strong> with a customer OK to share. If the team hits target on Monday, the email goes out without a photo.</p>";
        }
        else
        {
            cards = "";
            for each c in candidates
            {
                label = c.get("job_name");
                if(label == null || label == "")
                {
                    label = c.get("name");
                }
                meta = "";
                if(c.get("installed") != null && c.get("installed") != "")
                {
                    meta = c.get("installed");
                }
                if(c.get("sent_by") != null && c.get("sent_by") != "")
                {
                    if(meta != "")
                    {
                        meta = meta + " &middot; ";
                    }
                    meta = meta + "sent by " + c.get("sent_by");
                }
                // thumbnailLink is a short-lived signed URL (hours), fine
                // for a same-day pick. Bump its size from the 220px default.
                thumb = c.get("thumb_url");
                thumb_html = "";
                if(thumb != null && thumb != "")
                {
                    thumb = thumb.replaceAll("=s220", "=s400");
                    thumb_html = "<img src='" + thumb + "' width='200' alt='' style='display:block;width:200px;height:auto;border:0;'>";
                }
                cards = cards +
                    "<tr><td style='padding:12px 0;border-top:1px solid " + CARD_BORDER + ";vertical-align:top;width:212px;'>" + thumb_html + "</td>" +
                    "<td style='padding:12px 0 12px 12px;border-top:1px solid " + CARD_BORDER + ";vertical-align:top;font-family:" + SANS + ";'>" +
                    "<p style='margin:0;font-size:15px;font-weight:700;color:" + INK + ";'>" + label + "</p>" +
                    "<p style='margin:4px 0 10px;font-size:12px;color:" + TEXT_SECONDARY + ";'>" + meta + "</p>" +
                    "<a href='" + pick_api + joiner + "file_id=" + c.get("id") + "' style='display:inline-block;padding:8px 16px;background:" + COPPER + ";color:#FFFFFF;font-size:13px;font-weight:700;text-decoration:none;border-radius:6px;'>Use this one</a>" +
                    "&nbsp;&nbsp;<a href='" + c.get("view_url") + "' style='font-size:12px;color:#A85200;'>Open in Drive</a>" +
                    "</td></tr>";
            }
            body = "<p style='font-family:" + SANS + ";font-size:14px;color:" + INK + ";'>Pick tomorrow's <strong>Nailed It</strong> photo for the Utilization Actuals email. It only shows if the team hits target. Skip this and the newest photo (first below) is used.</p>" +
                "<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='max-width:600px;'>" + cards + "</table>";
        }

        sendmail
        [
            from: PICKER_FROM
            to: PICKER_TO
            subject: "Pick tomorrow's Nailed It photo"
            message: body
        ];
    }
    catch (e)
    {
        sendmail
        [
            from: PICKER_FROM
            to: PICKER_TO
            subject: "Nailed It photo picker FAILED"
            message: "The Sunday photo picker errored. Monday's actuals email still goes out; it will use the newest eligible photo if it can reach Drive, or skip the photo.\n\n" + e.toString()
        ];
    }
}
