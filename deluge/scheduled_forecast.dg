void scheduled_forecast()
{
    FAILURE_ALERT_TO = "henry@getlivewire.com";
    FAILURE_ALERT_FROM = "henry@getlivewire.com";

    try
    {
        // The forecast runs Friday at 4pm ET for the upcoming Sun-Sat.
        // Moved from Thursday per Dustin 2026-08-13: "Friday afternoon
        // 3-4pm for best results. Most of the data is going to be
        // dependent Josh/PM scheduling." Week boundary is Sun-Sat to
        // match Dustin's manual report and the iSolved payroll week
        // (Dustin 2026-08-31; supersedes Henry's 2026-08-25 keep-Mon-Sun
        // call). The Creator schedule day and days_to_sunday must move
        // together: from Friday, Sunday = today + 2 days (Thursday would
        // be + 3).
        // The UTC offset is computed per boundary date via eastern_offset
        // so a week straddling a DST transition gets the right offset on
        // each edge.
        today = zoho.currenttime.toDate();
        days_to_sunday = 2;
        week_start_date = today.addDay(days_to_sunday);
        week_end_date = week_start_date.addDay(6);
        week_start_str = week_start_date.toString("yyyy-MM-dd");
        week_end_str = week_end_date.toString("yyyy-MM-dd");
        week_start_iso = week_start_str + "T00:00:00" + thisapp.eastern_offset(week_start_str);
        week_end_iso = week_end_str + "T23:59:59" + thisapp.eastern_offset(week_end_str);

        run_id = zoho.encryption.urlEncode(zoho.currenttime.toString("yyyyMMddHHmmss") + "-" + randomNumber(1000, 9999));

        result = thisapp.generate_forecast(week_start_iso, week_end_iso);
        thisapp.write_forecast_history(result, run_id);
        thisapp.send_forecast_email(result);

        info "Forecast run " + run_id + " complete: " +
            result.get("rollup").get("tech_count") + " techs, " +
            result.get("events_count") + " events.";
    }
    catch (e)
    {
        sendmail
        [
            from: FAILURE_ALERT_FROM
            to: FAILURE_ALERT_TO
            subject: "Utilization Forecast automation FAILED"
            message: "The scheduled forecast run errored. Trace:\n\n" + e.toString()
        ];
    }
}
