 * Email / distribution
 * ============================================================ */

EMAIL_SENDER               = "henry@getlivewire.com";
EMAIL_PARALLEL_RUN_TO      = list("henry@getlivewire.com");    /* Henry-only until 2-week parallel match */
EMAIL_FULL_DISTRIBUTION    = list("henry@getlivewire.com");    /* TODO: expand at cutover — Leadership/PM/Logistics */
EMAIL_FAILURE_ALERT_TO     = "henry@getlivewire.com";

/* Brand styling — restyle in Phase 2 from claude.ai/design/p/9c200e29-... guide.
 * Defaults are clean/neutral placeholders. */
BRAND_PRIMARY_COLOR        = "#222222";
BRAND_TABLE_BORDER         = "#dddddd";
BRAND_FONT_STACK           = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";

/* ============================================================
 * Company-wide metrics (Dustin's spreadsheet 2026-05-15)
