BRAND_PRIMARY_COLOR        = "#222222";
BRAND_TABLE_BORDER         = "#dddddd";
BRAND_FONT_STACK           = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";

/* ============================================================
 * Company-wide metrics (Dustin's spreadsheet 2026-05-15)
 * ============================================================ */

/* Utilization targets — raised by Stacy, relayed by Dustin 2026-08-17,
 * approved by Henry same day. Was a flat 62.5%. Techs are now held to
 * 80%; service techs to 67.5%. Service roster per Henry 2026-08-17:
 * Jim Zimmerman is currently the only service tech (corroborated by
 * iSolved department 0400 vs installers' 0300/0302). */
TECH_UTILIZATION_TARGET         = 0.80;
SERVICE_TECH_UTILIZATION_TARGET = 0.675;
SERVICE_TECH_NAMES              = list();
SERVICE_TECH_NAMES.add("Jim Zimmerman");

/* Macro billable-hours goal — Stacy 2026-08-21: "we are driving toward
 * 230 billable hours per week." Henry chose 230 over the interim 175
 * Stacy floated (she expects it unattainable until Josh B is backfilled
 * plus one more hire — the red status is deliberate honesty, not a bug).
 * The FORECAST email's per-tech congrats line was removed the same day
 * (Henry: "no point congratulating people on work they haven't done")
 * and replaced with a red/yellow/green pacing line against this goal.
 * The ACTUALS email keeps its congrats line — that work is done.
 * Green at 100% of goal, yellow at 75%, red below. */
MACRO_BILLABLE_GOAL_HRS         = 230;
MACRO_GOAL_GREEN_AT             = 1.0;
MACRO_GOAL_YELLOW_AT            = 0.75;

