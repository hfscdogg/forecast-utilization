/*
 * config.dg — Single source of truth for every assumption in the automation.
 *
 * Every constant here was either confirmed by Dustin/Stacy (2026-05-12 / 2026-05-13 / 2026-05-15)
 * or marked TODO for verification at first deploy. Field-name assumptions follow
 * Zoho's display-label-to-underscored-api-name convention.
 *
 * Two strict separations are enforced by this file:
 *   1. FORECAST constants vs ACTUALS constants — per Dustin's rule that they
 *      are "two different systems and should remain that way for accurate data."
 *   2. CRM constants (Zoho Events/Users) vs iSolved constants (timecards) —
 *      the only external dependency in the whole stack.
 */

/* ============================================================
 * SHARED — CRM (Zoho) Event module
 * ============================================================ */

EVENTS_MODULE              = "Events";              /* confirmed via inspector 2026-05-18 */
FIELD_TECHNICIAN_1         = "Owner";               /* primary tech on the event (ownerlookup) */
FIELD_TECHNICIAN_2         = "Helper1";             /* API name for "Technician 2" picklist — confirmed 2026-05-18, NOT Technician_2 */
FIELD_DURATION_MAN_HRS     = "Duration_Man_Hrs";    /* confirmed 2026-05-18, formula field */
FIELD_DURATION_HRS         = "Duration_Hrs";        /* total event hours, formula field — useful for sanity checks */
FIELD_START_DATETIME       = "Start_DateTime";      /* confirmed 2026-05-18 */
FIELD_END_DATETIME         = "End_DateTime";        /* confirmed 2026-05-18 */
FIELD_EVENT_TYPE           = "Event_Type";          /* picklist, confirmed 2026-05-18 */
FIELD_EVENT_STATUS         = "Event_Status";        /* picklist, confirmed 2026-05-18 — the spec called this "Status" but the API name is Event_Status */
FIELD_TRIP_CHARGE          = "Trip_Charge";         /* PICKLIST (not boolean) — confirmed 2026-05-18, values TBD from picklist dump */
FIELD_BILLED               = "Billed";              /* boolean */
FIELD_PLACEHOLDER          = "Placeholder";         /* boolean — filter Placeholder events */
FIELD_HOURS_LOGGED         = "Hours_Logged";        /* double — actual hours logged on the event */

/* Event_Type picklist — confirmed via inspector 2026-05-18, categorization
 * confirmed by Dustin 2026-05-18. See docs/field_mapping.md for the full
 * picklist dump. Whitelist only — never blacklist. */

EVENT_TYPES_BILLABLE = list(
    "Trim-Out ($$$)",
    "Rough-In ($$$)",
    "Finish-Out ($$$)",
    "Discovery - Payment Required ($$$)",
    "Service - Payment Required ($$$)",
    "In-House Electrical",          /* Dustin 2026-05-19: works like Service -
                                       Payment Required, billable time */
    "Retrofit ($$$)"                /* Dustin: should be Finish-Out or Service instead,
                                       but Brian M used it this week. Billable when it
                                       appears — the email flags it so Dustin can fix
                                       the source record. */
);

/* Confirmed NOT in use by Dustin 2026-05-18: Sub Contractor Finish-Out ($$$),
 * Discovery - Prepaid, Remote Assistance (Payment Required), Remote Support
 * (Parasol). Deliberately omitted from every whitelist so they fall through
 * to "unknown" and get flagged in the email if one ever appears (it would be
 * a data-entry mistake worth surfacing). */

EVENT_TYPES_NON_BILLABLE = list(
    "Service - Warranty / Punchout",
    "Install - Warranty / Punchout",
    "Package Overage - Non Billable",
    "Meeting -Non Billable",
    "Project Management",
    "Undersold - Not Billable"
);

EVENT_TYPE_TRAINING        = "Training";            /* counts as worked, flag if drives OT */

EVENT_TYPE_PLACEHOLDER     = "Place Holder";        /* the Event_Type value (note space) — also see FIELD_PLACEHOLDER boolean */

/* Deliberate exclusions — known and intentional, NOT flagged as unknown. */
EVENT_TYPES_EXCLUDED = list(
    "Scheduled Off",        /* Dustin: tech not working that day — do not count */
    "Place Holder",         /* PM placeholder, owner-routed, not counted in hours */
    "Service Location",     /* Dustin: online-booking blocker, not billable, not counted at all */
    "-None-"                /* default empty value */
);

/* On-site classification for the 30-minute drive-time adder.
 * Dustin 2026-05-18: the 0.5 hr adder applies to every event WITHOUT a trip
 * charge, but ONLY when the tech drives to an actual customer site. Meetings
 * or training at the shop get no adder.
 * On-site = billable jobs + warranty/punchout (all at customer locations).
 * TODO reconcile during parallel run: Package Overage and Undersold are
 * billing adjustments treated as on-site here since they attach to real
 * jobs — confirm with Dustin if the forecast drifts. */
EVENT_TYPES_ONSITE = list(
    "Trim-Out ($$$)",
    "Rough-In ($$$)",
    "Finish-Out ($$$)",
    "Discovery - Payment Required ($$$)",
    "Service - Payment Required ($$$)",
    "In-House Electrical",
    "Retrofit ($$$)",
    "Service - Warranty / Punchout",
    "Install - Warranty / Punchout",
    "Package Overage - Non Billable",
    "Undersold - Not Billable"
);

/* Event_Status picklist values — confirmed via inspector 2026-05-18.
 * Cancellation handling (Dustin 2026-05-18): cancelled events are NOT deleted
 * (Zoho reporting misbehaves on deletes). Dustin sets Event_Status to
 * "Incomplete - Job Not Ready", changes the duration to 1 minute, and writes
 * the reason into Action_Taken_Office_Only.
 * Consequence: NO status filter is needed. A cancelled event's 1-minute
 * duration self-neutralizes when Duration_Man_Hrs is summed (~0.017 hr noise).
 * "Incomplete - Job Not Ready" is ALSO a legitimate status for genuinely-
 * not-ready jobs, so it must never be blanket-filtered. */
EVENT_STATUS_COMPLETE                = "Complete";
EVENT_STATUS_INCOMPLETE              = "Incomplete";
EVENT_STATUS_INCOMPLETE_JOB_NOT_READY = "Incomplete - Job Not Ready";
EVENT_STATUS_READY_TO_BILL           = "Ready to Bill";

FIELD_ACTION_TAKEN         = "Action_Taken_Office_Only";  /* cancellation reason text */

/* Cancelled-event heuristic for the auto-Notes feature: an event with status
 * "Incomplete - Job Not Ready" AND a duration under this threshold is a
 * cancellation, not a real not-ready job. Used only for email annotations,
 * never for filtering hours. */
CANCELLED_EVENT_MAX_HOURS  = 0.1;

/* Trip_Charge picklist — numeric count ("1".."4") or null/"-None-".
 * Sample observed: null on a single-tech 8-hour job. "No trip charge" means
 * Trip_Charge IS NULL OR "-None-" OR "0". */
TRIP_CHARGE_NONE_VALUES = list(null, "-None-", "0");

/* ============================================================
 * SHARED — CRM (Zoho) Users (built-in users endpoint)
 * ============================================================ */

USERS_ENDPOINT             = "/crm/v6/users?type=ActiveUsers";
FIELD_USER_ID              = "id";                  /* matches Owner.id on Events */
FIELD_USER_FULL_NAME       = "full_name";           /* matches Helper1 picklist display values */
FIELD_USER_EMAIL           = "email";
FIELD_USER_STATUS          = "status";              /* "active" for active users */
USER_STATUS_ACTIVE         = "active";              /* the Active filter — confirmed 2026-05-18 */
FIELD_USER_ROLE            = "role";                /* nested: role.name */
FIELD_USER_PROFILE         = "profile";             /* nested: profile.name */

/* Technician identification — resolved 2026-05-19, no new CRM field needed.
 * Henry: office staff (CEO / sales / admin) do not own field events. So the
 * technician roster for a given week is derived from the data: the distinct
 * set of Owner and Helper1 values appearing on events of real field-work
 * types (billable / non-billable on-site / training) within that week.
 * A tech who is totally idle a given week has nothing to forecast anyway. */
TECHNICIAN_FILTER_STRATEGY = "derive_from_event_ownership";

/* Role-based roster exclusions — added 2026-08-13 per Henry + Dustin's
 * 8/17-8/23 forecast review. Project/service managers occasionally own a
 * non-billable event (a meeting, project management) which pulls them into
 * the derived roster at 0% and drags the company average down. This is a
 * ROLE exclusion, not a zero-billable exclusion: a real field tech with no
 * billable work in a week still counts, because that low utilization is the
 * whole point of the metric. Filter these full_name values out of the
 * roster in generate_forecast.dg and generate_actuals.dg. Add names as
 * roles change. Verified: Dustin's 8/17-8/23 company figure (84.77% with
 * Elijah, 83.94% without) reconciles exactly once these two are excluded. */
EXCLUDED_NON_TECH_NAMES = list();
EXCLUDED_NON_TECH_NAMES.add("Dustin Roskam");   /* Service Manager */
EXCLUDED_NON_TECH_NAMES.add("Josh McDonough");  /* Project Manager */
EXCLUDED_NON_TECH_NAMES.add("David Hicks");     /* Ops — fixes timecards; entered roster via a 1-minute cancelled event. Dustin 2026-08-17, Henry approved */

/* Ramp-up rule — Stacy 2026-08-18: "A new technician is considered
 * non-billable for the first 3 months... 3 months from the time of
 * hire." Supersedes Henry's 2026-08-17 keep-Elijah-in ruling with a
 * time-boxed version of the same principle: a ramp-up tech stays
 * visible in the table and the hour totals (the paid cost is real and
 * shown) but is left out of the company average and the congrats list
 * until the report week ends on or after billable_from (hire + 3
 * months). Graduation is automatic. Maintained as a name -> date map
 * in generate_forecast.dg and generate_actuals.dg; add each new hire
 * at hire date + 3 months. A new hire missing from the map counts
 * fully and visibly drags the number — the conservative failure mode. */
RAMP_UP_BILLABLE_FROM = map();
RAMP_UP_BILLABLE_FROM.put("Elijah Good", "2026-10-01");  /* hired 2026-07-01 */

/* iSolved linkage — to be added once McKenzie/Dustin confirm tenant access */
FIELD_USER_ISOLVED_ID      = "iSolved_Employee_ID"; /* Phase 4b: custom field on Users, one-time backfill */

/* ============================================================
 * FORECAST — Friday 4 PM ET
 * Moved from Thursday per Dustin 2026-08-13: "Friday afternoon 3-4pm
 * for best results. Most of the data is going to be dependent Josh/PM
 * scheduling. I'll let him know that he should expect that deadline."
 * If this day changes again, scheduled_forecast.dg days_to_monday must
 * change with it (Friday = 3, Thursday = 4).
 * ============================================================ */

FORECAST_SCHEDULE_DAY      = "Friday";
FORECAST_SCHEDULE_TIME     = "16:00";               /* America/New_York */
FORECAST_TIMEZONE          = "America/New_York";

/* The 30-minute adder for non-trip-charge events.
 * TODO Phase 1: confirm whether this applies to ALL non-trip events or
 * only non-billable ones. Spec Section 5.2 is ambiguous. Ask Dustin during build. */
FORECAST_NON_TRIP_ADDER_HRS = 0.5;

FORECAST_WEEKLY_CAP_HRS    = 40;                    /* hard cap, overflow = OT */

FORECAST_HISTORY_FORM      = "Utilization_Forecast_History";

/* ============================================================
 * ACTUALS (LAGGING) — Monday 4 PM ET, reporting on the week ending 8 days prior
 * ============================================================ */

ACTUALS_SCHEDULE_DAY       = "Monday";
ACTUALS_SCHEDULE_TIME      = "16:00";               /* America/New_York */
ACTUALS_LAG_WEEKS          = 2;                     /* SOP: "two weeks prior to current date" */
ACTUALS_DRIVE_TIME_ENABLED = false;                 /* spec/SOP: actuals do NOT apply the 30-min drive-time adder */

/* OT pay multiplier — verified from Dustin's spreadsheet 2026-05-15.
 * actual_hours_paid = hours_worked + (ot * OT_PAY_MULTIPLIER)
 * Grant (40 worked + 2.88 OT) -> 44.32 paid : 40 + 2.88*1.5 = 44.32 ✓
 * Stephen (40 worked + 3.92 OT) -> 45.88 paid : 40 + 3.92*1.5 = 45.88 ✓ */
OT_PAY_MULTIPLIER          = 1.5;

ACTUALS_HISTORY_FORM       = "Utilization_Actuals_History";

/* ============================================================
 * iSolved API (Phase 4b — Hours Worked source)
 * Live as of 2026-08-14. Credentials (OAuth client id + secret) live in
 * Creator App Variables ISOLVED_BASE_URL / ISOLVED_CLIENT_ID /
 * ISOLVED_CLIENT_SECRET — never in this repo (GitGuardian rule).
 * ============================================================ */

ISOLVED_BASE_URL_VALUE     = "https://dominionpayroll.net/rest";  /* mirror of the Creator variable, for the record */
ISOLVED_CLIENT_PATH_ID     = "357";                 /* Livewire's client id — Ron Pisarz 2026-08-13, verified live 2026-08-14 */
ISOLVED_LEGAL_ID           = "417";                 /* Livewire's legal id — same source */
ISOLVED_TIMECARD_ENDPOINT  = "/api/clients/{clientId}/legals/{legalId}/timecardData?startDate=&endDate=";  /* datetimes required, results envelope, page param */

/* Pay items that count as time on the clock — whitelist only, observed
 * live 2026-08-14 (Aug 3-9 week). Everything not listed is excluded by
 * default, which automatically covers Holiday / Sick / Bereavement when
 * they first appear.
 *   "Hourly Regular" (code 01a)  counts
 *   "Overtime"       (code 2)    counts
 *   "PTO"            (code 209E) excluded per SOP: only time on the clock
 *   "Salary Hours"   (null code) excluded: office staff, never in roster */
ISOLVED_PAY_ITEMS_WORKED   = list("Hourly Regular", "Overtime");

/* iSolved full-name -> Zoho full_name aliases. iSolved carries legal
 * names; Zoho carries the names techs go by. Extend as variants appear
 * (fetch_isolved_timecards.dg passes unlisted names through unchanged,
 * and a name that matches no Zoho tech shows up as a tech with null
 * timecard data in the Monday email — visible, not silent). */
ISOLVED_NAME_ALIAS_JAMES_ZIMMERMAN = "Jim Zimmerman";

/* ============================================================
 * Email / distribution
