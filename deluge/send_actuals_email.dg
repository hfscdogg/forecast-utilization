void send_actuals_email(Map result)
{
    BRAND_PRIMARY_COLOR = "#222222";
    BRAND_TABLE_BORDER = "#dddddd";
    BRAND_TABLE_HEADER_BG = "#f4f4f4";
    BRAND_PENDING_BG = "#fff8e1";
    BRAND_FONT_STACK = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";
    // Raised from 62.50% per Stacy via Dustin 2026-08-17, Henry approved:
    // 80% for techs, 67.50% for service techs (SERVICE_TECH_NAMES in
    // generate_actuals.dg). The congrats line names both: it used to say
    // "above our 80.00% target" while congratulating Jim at 68.17%
    // against his 67.50% service target (9/20-9/26 actuals, 2026-10-07).
    // Keep in sync with the targets in generate_actuals.dg.
    TARGET_PCT_DISPLAY = "80.00% for techs, 67.50% for service techs";
    PLACEHOLDER = "&mdash;";

    // Livewire Design System v3.0 tokens for the Raving Fan snapshot block.
    // See docs/Livewire_Design_System.md sections 1.2, 2.3, 2.6.
    // Light card (2026-09-21): the original dark #1A1A1A card rendered
    // unreadable in Gmail, whose message theming recolors light text on a
    // dark source background. Email clients' dark-mode transforms assume
    // dark-text-on-light source, so the card is now warm grey with ink
    // text and a copper accent, legible under both themes.
    RF_CARD_BG = "#FAFAF9";
    RF_CARD_BORDER = "#E5E5E0";
    RF_INK = "#1A1A1A";
    RF_TEXT_SECONDARY = "#6B6B60";
    RF_COPPER = "#F7941D";
    // No quotes in this stack: it goes inside single-quoted style
    // attributes, and the old 'Montserrat' / 'Segoe UI' quotes closed the
    // attribute early, so clients dropped the block's styling (tall
    // default-margin card, default-blue CTA link). System fonts only.
    RF_SANS_STACK = "-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif";
    RAVING_FAN_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vRsQaH6Q29LCTAkbX_t8_yB3cTXLcXt9EUU9OEn8xE8vzla4j8ijx7Wb1exPNAuDUw79_EBil_N2Gfc/pub?output=csv";
    RAVING_FAN_URL = "https://hfscdogg.github.io/raving-fan/";

    // Nailed It showcase card (Henry 2026-11-06). Python mirror:
    // nailed_it.py. Every Monday shows one real photo of finished work to
    // show off the crews, independent of the utilization number: the photo
    // Henry picked from Sunday's picker email (Nailed_It_Photos, Status
    // "Picked"), else Sunday's "Suggested" top vision-scored photo (only
    // written when it cleared NAILED_IT_MIN_SCORE), else no card. The only
    // bar is photo quality. The 75% TEAM_VERDICT_TARGET gate (2026-11-04
    // design) is retired; the per-tech congrats targets above are unrelated
    // and unchanged.
    // Failed It contrast (Henry 2026-11-06 11:58): when the curated Drive
    // folder below has images, the card shows two photos side by side,
    // Failed It on the left (someone else's bad install found online, never
    // a Livewire crew) and Nailed It on the right. Still no tie to
    // utilization. Humans curate the folder; it sits under Livewire Job
    // Photos (CRM Sync), so its files inherit "anyone with the link". The
    // week's image is the folder's files sorted by name, index
    // ws.getWeekOfYear() % count. Empty folder or a failed listing means
    // the Nailed It card alone. Keep in sync with config.dg.
    NAILED_IT_FAILED_FOLDER_ID = "1befbCvOuzb4bFO9u3sBzVmpxsaW0Lk8W";

    // Full distribution — Henry 2026-09-10: "forecast & utilization
    // reports going to all@getlivewire.com effective immediately."
    // Supersedes the Henry-only parallel-run address and Dustin's 8/28
    // group-list suggestion (PM/Leadership/Logistics + Production).
    EMAIL_TO = "all@getlivewire.com";
    EMAIL_SENDER = "henry@getlivewire.com";

    techs = result.get("techs");
    rollup = result.get("rollup");
    week_start_str = result.get("week_start");
    week_end_str = result.get("week_end");
    isolved_pending = rollup.get("isolved_pending");

    ws = week_start_str.toDate();
    we = week_end_str.toDate();
    week_label = ws.toString("EEE MMM d") + " to " + we.toString("EEE MMM d");

    // Sort desc by actual_utilization when present, else by hours_billed.
    sorted_techs = List();
    for each r in techs
    {
        inserted = false;
        new_sorted = List();
        r_key = r.get("actual_utilization");
        if(r_key == null)
        {
            if(isolved_pending)
            {
                r_key = r.get("hours_billed");
            }
            else
            {
                // Missing-timecard rows sink below every real percentage.
                r_key = -1;
            }
        }
        for each existing in sorted_techs
        {
            e_key = existing.get("actual_utilization");
            if(e_key == null)
            {
                if(isolved_pending)
                {
                    e_key = existing.get("hours_billed");
                }
                else
                {
                    e_key = -1;
                }
            }
            if(!inserted && r_key > e_key)
            {
                new_sorted.add(r);
                inserted = true;
            }
            new_sorted.add(existing);
        }
        if(!inserted)
        {
            new_sorted.add(r);
        }
        sorted_techs = new_sorted;
    }

    rows_html = "";
    for each r in sorted_techs
    {
        hb = r.get("hours_billed");
        hw = r.get("hours_worked");
        ot = r.get("ot");
        ahp = r.get("actual_hours_paid");
        au = r.get("actual_utilization");
        nbh = r.get("non_billable_hours");

        hb_disp = hb.round(2);
        nbh_disp = nbh.round(2);
        hw_disp = PLACEHOLDER;
        if(hw != null)
        {
            hw_disp = hw.round(2);
        }
        ot_disp = PLACEHOLDER;
        if(ot != null)
        {
            ot_disp = ot.round(2);
        }
        ahp_disp = PLACEHOLDER;
        if(ahp != null)
        {
            ahp_disp = ahp.round(2);
        }
        au_disp = PLACEHOLDER;
        if(au != null)
        {
            au_disp = (au * 100).round(2) + "%";
        }

        notes_parts = List();
        if(r.get("timecard_missing") == true)
        {
            notes_parts.add("timecard missing in iSolved at run time");
        }
        if(r.get("ramp_up") == true)
        {
            notes_parts.add("ramp-up, counts from " + r.get("billable_from"));
        }
        if(nbh > 0)
        {
            notes_parts.add(nbh.round(2) + " non-billable hours");
        }
        if(ot != null && ot > 0)
        {
            notes_parts.add(ot.round(2) + " OT");
        }
        notes_html = "";
        for each p in notes_parts
        {
            if(notes_html != "")
            {
                notes_html = notes_html + "; ";
            }
            notes_html = notes_html + p;
        }

        rows_html = rows_html +
            "<tr>" +
            "<td>" + r.get("technician") + "</td>" +
            "<td style='text-align:right'>" + hb_disp + "</td>" +
            "<td style='text-align:right'>" + hw_disp + "</td>" +
            "<td style='text-align:right'>" + ot_disp + "</td>" +
            "<td style='text-align:right'>" + ahp_disp + "</td>" +
            "<td style='text-align:right'><strong>" + au_disp + "</strong></td>" +
            "<td style='text-align:right'>" + nbh_disp + "</td>" +
            "<td style='font-size:11px;color:#666'>" + notes_html + "</td>" +
            "</tr>";
    }

    // ============================================================
    // Raving Fan snapshot block. Fetches the latest week with a valid
    // Fan Score from the published Google Sheet CSV, renders a
    // Livewire-design-system-compliant block. Silent fail if the
    // fetch errors or no valid row is found.
    // ============================================================
    raving_fan_block = "";
    try
    {
        rf_resp = invokeurl
        [
            url: RAVING_FAN_CSV_URL
            type: GET
        ];
        rf_text = rf_resp + "";
        if(rf_text != null && rf_text != "")
        {
            // Header-aware parsing, ported from the dashboard
            // (hfscdogg/raving-fan index.html parseScorecard) after the
            // fixed-position version matched nothing on the live sheet
            // (verified 2026-09-10 via inspect_raving_fan): the sheet has
            // decorative rows above/below the table and its columns have
            // drifted before, so columns are located by header TEXT.
            // Deluge's toList drops empty tokens, which would silently
            // shift sparse rows — pad a space after every comma (and one
            // in front for a leading empty cell) so every cell survives.
            // Only the header line and the date-bearing lines below it
            // are split into cells: splitting and trimming every cell of
            // the whole sheet (decorative rows, pre-filled quarters) cost
            // thousands of statements and helped push the 2026-10-05 run
            // past Creator's statement-execution limit.
            // Header row: "Week Ending" + "Total Fan Score" together (or
            // "Week Beginning" as fallback), matching the dashboard.
            rf_lines = rf_text.toList("\n");
            header_idx = -1;
            hrow = List();
            candidate_lines = List();
            for each line in rf_lines
            {
                if(header_idx < 0)
                {
                    ll = line.toLowerCase();
                    if((ll.contains("week ending") && ll.contains("total fan score")) || ll.contains("week beginning"))
                    {
                        header_idx = 0;
                        raw_cells = (" " + line.replaceAll(",", ", ")).toList(",");
                        for each c in raw_cells
                        {
                            hrow.add(c.trim());
                        }
                    }
                }
                else if(line.contains("/"))
                {
                    candidate_lines.add(line);
                }
            }
            // Map columns by header name; backfill any missing from the
            // sheet's fixed order relative to Week Beginning.
            col_wb = -1;
            col_we = -1;
            col_rev = -1;
            col_men = -1;
            col_ref = -1;
            col_rep = -1;
            col_fs = -1;
            if(header_idx >= 0)
            {
                ci = 0;
                for each c in hrow
                {
                    lc = c.toLowerCase();
                    if(col_wb < 0 && lc.contains("week beginning"))
                    {
                        col_wb = ci;
                    }
                    if(col_we < 0 && lc.contains("week ending"))
                    {
                        col_we = ci;
                    }
                    if(col_rev < 0 && lc.contains("5-star"))
                    {
                        col_rev = ci;
                    }
                    if(col_men < 0 && lc.contains("mentioning staff"))
                    {
                        col_men = ci;
                    }
                    if(col_ref < 0 && lc.contains("referred leads"))
                    {
                        col_ref = ci;
                    }
                    if(col_rep < 0 && lc.contains("repeat clients"))
                    {
                        col_rep = ci;
                    }
                    if(col_fs < 0 && lc.contains("total fan score"))
                    {
                        col_fs = ci;
                    }
                    ci = ci + 1;
                }
                if(col_wb >= 0)
                {
                    if(col_we < 0)
                    {
                        col_we = col_wb + 1;
                    }
                    if(col_rev < 0)
                    {
                        col_rev = col_wb + 2;
                    }
                    if(col_men < 0)
                    {
                        col_men = col_wb + 3;
                    }
                    if(col_ref < 0)
                    {
                        col_ref = col_wb + 4;
                    }
                    if(col_rep < 0)
                    {
                        col_rep = col_wb + 5;
                    }
                    if(col_fs < 0)
                    {
                        col_fs = col_wb + 6;
                    }
                }
            }
            metric_cols = List();
            metric_cols.add(col_rev);
            metric_cols.add(col_men);
            metric_cols.add(col_ref);
            metric_cols.add(col_rep);
            // Latest completed week: the LAST row after the header whose
            // Week Ending is a real date AND that has at least one metric
            // filled in — the sheet pre-fills the whole quarter's week
            // rows, so empty future weeks must not render as zeros.
            rf_target = null;
            if(header_idx >= 0 && col_we >= 0)
            {
                for each line in candidate_lines
                {
                    row = List();
                    raw_cells = (" " + line.replaceAll(",", ", ")).toList(",");
                    for each c in raw_cells
                    {
                        row.add(c.trim());
                    }
                    if(row.size() > col_we)
                    {
                        we_cell = row.get(col_we);
                        // No regex: Deluge string literals pass backslashes
                        // verbatim, so "\\d" reached the engine as a literal
                        // backslash + d and matched nothing (burned inspector
                        // rounds 1-3). Structural test instead: 2-3 "/"-separated
                        // all-numeric parts covers "9/7", "7/4/26", "7/4/2026".
                        is_date = false;
                        if(we_cell.contains("/"))
                        {
                            date_parts = we_cell.toList("/");
                            if(date_parts.size() >= 2 && date_parts.size() <= 3)
                            {
                                is_date = true;
                                for each dp in date_parts
                                {
                                    dpt = dp.trim();
                                    if(dpt == "" || !dpt.isNumber() || dpt.contains("."))
                                    {
                                        is_date = false;
                                    }
                                }
                            }
                        }
                        if(is_date)
                        {
                            has_entry = false;
                            for each mc in metric_cols
                            {
                                if(mc >= 0 && row.size() > mc && row.get(mc) != "")
                                {
                                    has_entry = true;
                                }
                            }
                            if(has_entry)
                            {
                                rf_target = row;
                            }
                        }
                    }
                }
            }
            if(rf_target != null)
            {
                rf_week_end = rf_target.get(col_we);
                rf_reviews = 0;
                if(col_rev >= 0 && rf_target.size() > col_rev && rf_target.get(col_rev).trim().isNumber() && !rf_target.get(col_rev).contains("."))
                {
                    rf_reviews = rf_target.get(col_rev).toLong();
                }
                rf_mentions = 0;
                if(col_men >= 0 && rf_target.size() > col_men && rf_target.get(col_men).trim().isNumber() && !rf_target.get(col_men).contains("."))
                {
                    rf_mentions = rf_target.get(col_men).toLong();
                }
                rf_referrals = 0;
                if(col_ref >= 0 && rf_target.size() > col_ref && rf_target.get(col_ref).trim().isNumber() && !rf_target.get(col_ref).contains("."))
                {
                    rf_referrals = rf_target.get(col_ref).toLong();
                }
                rf_repeat = 0;
                if(col_rep >= 0 && rf_target.size() > col_rep && rf_target.get(col_rep).trim().isNumber() && !rf_target.get(col_rep).contains("."))
                {
                    rf_repeat = rf_target.get(col_rep).toLong();
                }
                // Fan Score: the sheet's cell when populated, else the sum
                // of the four metrics (dashboard behavior).
                rf_fan_score = 0;
                if(col_fs >= 0 && rf_target.size() > col_fs && rf_target.get(col_fs).trim().isNumber() && !rf_target.get(col_fs).contains("."))
                {
                    rf_fan_score = rf_target.get(col_fs).toLong();
                }
                if(rf_fan_score == 0)
                {
                    rf_fan_score = rf_reviews + rf_mentions + rf_referrals + rf_repeat;
                }

                // Compact stat-row layout (2026-10-05): four inputs, an "="
                // glyph, then Fan Score in orange so the row reads as a sum.
                // Email-safe: nested tables, inline styles, no media query
                // (the email has none), so one row that fits at 600px.
                // Orange only on Fan Score and the button.
                rf_cell_style = "padding:8px 4px;text-align:center;vertical-align:middle;";
                rf_divided_cell_style = rf_cell_style + "border-left:1px solid " + RF_CARD_BORDER + ";";
                metric_value_style = "margin:0;font-family:" + RF_SANS_STACK + ";font-size:24px;line-height:28px;font-weight:700;color:" + RF_INK + ";";
                metric_label_style = "margin:4px 0 0;font-family:" + RF_SANS_STACK + ";font-size:10px;line-height:12px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;color:" + RF_TEXT_SECONDARY + ";";
                fan_value_style = "margin:0;font-family:" + RF_SANS_STACK + ";font-size:34px;line-height:38px;font-weight:700;color:" + RF_COPPER + ";";
                fan_label_style = "margin:2px 0 0;font-family:" + RF_SANS_STACK + ";font-size:10px;line-height:12px;letter-spacing:0.08em;text-transform:uppercase;font-weight:700;color:" + RF_INK + ";";

                raving_fan_block =
                    "<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='width:100%;background:" + RF_CARD_BG + ";border:1px solid " + RF_CARD_BORDER + ";border-collapse:separate;margin:0 0 16px;'>" +
                    "<tr><td style='padding:14px 20px 12px;'>" +
                    "<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%'>" +
                    "<tr>" +
                    "<td style='font-family:" + RF_SANS_STACK + ";font-size:16px;line-height:20px;font-weight:700;color:" + RF_INK + ";text-align:left;vertical-align:baseline;'>Raving Fan Snapshot</td>" +
                    "<td style='font-family:" + RF_SANS_STACK + ";font-size:12px;line-height:20px;color:" + RF_TEXT_SECONDARY + ";text-align:right;vertical-align:baseline;white-space:nowrap;'>Week ending " + rf_week_end + "</td>" +
                    "</tr>" +
                    "</table>" +
                    "<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='margin:10px 0 0;border-top:1px solid " + RF_CARD_BORDER + ";border-bottom:1px solid " + RF_CARD_BORDER + ";'>" +
                    "<tr>" +
                    "<td width='17%' style='" + rf_cell_style + "'>" +
                    "<p style='" + metric_value_style + "'>" + rf_reviews + "</p>" +
                    "<p style='" + metric_label_style + "'>Reviews</p>" +
                    "</td>" +
                    "<td width='17%' style='" + rf_divided_cell_style + "'>" +
                    "<p style='" + metric_value_style + "'>" + rf_mentions + "</p>" +
                    "<p style='" + metric_label_style + "'>Mentions</p>" +
                    "</td>" +
                    "<td width='17%' style='" + rf_divided_cell_style + "'>" +
                    "<p style='" + metric_value_style + "'>" + rf_referrals + "</p>" +
                    "<p style='" + metric_label_style + "'>Referrals</p>" +
                    "</td>" +
                    "<td width='17%' style='" + rf_divided_cell_style + "'>" +
                    "<p style='" + metric_value_style + "'>" + rf_repeat + "</p>" +
                    "<p style='" + metric_label_style + "'>Repeat</p>" +
                    "</td>" +
                    "<td width='6%' style='padding:8px 0;text-align:center;vertical-align:middle;font-family:" + RF_SANS_STACK + ";font-size:22px;line-height:28px;font-weight:400;color:" + RF_TEXT_SECONDARY + ";border-left:1px solid " + RF_CARD_BORDER + ";'>=</td>" +
                    "<td width='26%' style='" + rf_cell_style + "'>" +
                    "<p style='" + fan_value_style + "'>" + rf_fan_score + "</p>" +
                    "<p style='" + fan_label_style + "'>Fan Score</p>" +
                    "</td>" +
                    "</tr>" +
                    "</table>" +
                    "<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='margin:12px 0 0;'>" +
                    "<tr>" +
                    "<td style='font-family:" + RF_SANS_STACK + ";font-size:11px;line-height:14px;color:" + RF_TEXT_SECONDARY + ";text-align:left;vertical-align:middle;'>Updated weekly by the Raving Fan team.</td>" +
                    "<td align='right' style='vertical-align:middle;'>" +
                    "<table role='presentation' cellpadding='0' cellspacing='0' border='0' align='right'>" +
                    "<tr><td align='center' bgcolor='" + RF_COPPER + "' style='background:" + RF_COPPER + ";border-radius:6px;mso-padding-alt:10px 20px;'>" +
                    "<a href='" + RAVING_FAN_URL + "' target='_blank' style='display:inline-block;padding:10px 20px;font-family:" + RF_SANS_STACK + ";font-size:13px;line-height:16px;font-weight:700;color:#FFFFFF;text-decoration:none;border-radius:6px;'><span style='color:#FFFFFF;text-decoration:none;'>Open the Scorecard</span></a>" +
                    "</td></tr>" +
                    "</table>" +
                    "</td>" +
                    "</tr>" +
                    "</table>" +
                    "</td></tr></table>";
            }
        }
    }
    catch (rf_err)
    {
        raving_fan_block = "";
    }

    // Banner and lead-in vary by mode.
    banner = "";
    if(isolved_pending)
    {
        banner = "<p style='background:" + BRAND_PENDING_BG + ";padding:10px 14px;border-left:3px solid #d4a017;font-size:13px;'><strong>iSolved integration pending:</strong> Hours Worked, OT, Actual Hours Paid and Actual Utilization will populate once the iSolved tenant API access is wired. Until then those columns show " + PLACEHOLDER + ". Hours Billed and Non-Billable Hours come straight from CRM and are correct as of this run.</p>";
    }
    else
    {
        missing_techs = rollup.get("timecard_missing_techs");
        if(missing_techs != null && missing_techs.size() > 0)
        {
            missing_joined = "";
            mn = missing_techs.size();
            mi = 0;
            for each mname in missing_techs
            {
                if(mi == 0)
                {
                    missing_joined = mname;
                }
                else if(mi == mn - 1)
                {
                    missing_joined = missing_joined + " and " + mname;
                }
                else
                {
                    missing_joined = missing_joined + ", " + mname;
                }
                mi = mi + 1;
            }
            banner = "<p style='background:" + BRAND_PENDING_BG + ";padding:10px 14px;border-left:3px solid #d4a017;font-size:13px;'><strong>Timecard missing:</strong> " + missing_joined + " had billed hours but no iSolved time when this run fired, so their utilization shows " + PLACEHOLDER + " and they are left out of the company average. Re-run once the time is entered for a corrected number.</p>";
        }
    }

    // Multi-day / all-day scheduling blocks excluded from the numbers
    // (2026-09-11: a 240 h Rough-In block put the forecast at 618
    // scheduled billable hours; the actuals side carries the same
    // guard). Flagged so the schedule gets fixed at the source.
    blocks = rollup.get("block_events");
    if(blocks != null && blocks.size() > 0)
    {
        items = "";
        for each blk in blocks
        {
            line = blk.get("owner");
            blk_helper = blk.get("helper");
            if(blk_helper != null && blk_helper != "No Helper" && blk_helper != "-None-" && blk_helper != "")
            {
                line = line + " + " + blk_helper;
            }
            line = line + " &mdash; " + blk.get("event_type") + ", " + blk.get("start") + " to " + blk.get("end") + " (" + blk.get("duration_hrs").round(1) + " h)";
            items = items + "<li>" + line + "</li>";
        }
        banner = banner + "<p style='background:" + BRAND_PENDING_BG + ";padding:10px 14px;border-left:3px solid #d4a017;font-size:13px;'><strong>Not counted:</strong> " + blocks.size() + " multi-day scheduling block(s) longer than 16 hours were left out of every figure below. These jobs need day-by-day events on the calendar to count:</p><ul style='font-size:12px;color:#666;margin-top:4px'>" + items + "</ul>";
    }

    lead_in = "";
    congrats_line = "";
    if(isolved_pending)
    {
        lead_in = "<p>Last week we billed <strong>" + rollup.get("total_billable").round(2) + "</strong> hours across <strong>" + rollup.get("tech_count") + "</strong> technicians, averaging <strong>" + rollup.get("avg_billable_per_tech").round(2) + "</strong> billable hours per tech. Non-billable hours totalled <strong>" + rollup.get("total_non_billable").round(2) + "</strong>.</p>";
    }
    else
    {
        company_util_pct = (rollup.get("company_utilization") * 100).round(2) + "%";
        lead_in = "<p>Last week we billed <strong>" + rollup.get("total_billable").round(2) + "</strong> hours across <strong>" + rollup.get("tech_count") + "</strong> technicians, averaging <strong>" + rollup.get("avg_billable_per_tech").round(2) + "</strong> billable hours per tech for a company utilization of <strong>" + company_util_pct + "</strong>.</p>";

        above_target = rollup.get("techs_above_target");
        if(above_target.size() == 0)
        {
            congrats_line = "<p>No technician landed above their utilization target last week (" + TARGET_PCT_DISPLAY + ").</p>";
        }
        else
        {
            joined = "";
            n = above_target.size();
            i = 0;
            for each name in above_target
            {
                if(i == 0)
                {
                    joined = name;
                }
                else if(i == n - 1)
                {
                    joined = joined + " and " + name;
                }
                else
                {
                    joined = joined + ", " + name;
                }
                i = i + 1;
            }
            congrats_line = "<p>Congrats to <strong>" + joined + "</strong> for being above their utilization target (" + TARGET_PCT_DISPLAY + ").</p>";
        }
    }

    // Nailed It showcase card. Silent on any error, like the Raving Fan
    // block: the email must never fail over a photo.
    verdict_block = "";
    nailed_rec_id = null;
    try
    {
        today = zoho.currentdate;
        picks = Nailed_It_Photos[Status == "Picked" && Send_Date <= today] sort by Send_Date desc;
        for each pk in picks
        {
            if(nailed_rec_id == null)
            {
                nailed_rec_id = pk.ID;
            }
        }
        if(nailed_rec_id == null)
        {
            // No pick: Sunday's "Suggested" record, the top vision-scored
            // photo, written only when it cleared the score bar
            // (scheduled_photo_picker.dg). It is made public only now, at
            // send time. No suggestion means no card this week rather than
            // a mediocre photo. Only this week's suggestion: an older one
            // belongs to a week that was never re-scored.
            suggestions = Nailed_It_Photos[Status == "Suggested" && Send_Date <= today && Send_Date > today.subDay(7)] sort by Send_Date desc;
            for each sg in suggestions
            {
                if(nailed_rec_id == null)
                {
                    public_id = thisapp.nailed_it_share(sg.File_ID);
                    if(public_id != "")
                    {
                        sg.Public_File_ID = public_id;
                        nailed_rec_id = sg.ID;
                    }
                }
            }
        }
        if(nailed_rec_id != null)
        {
            rec = Nailed_It_Photos[ID == nailed_rec_id];
            image_id = rec.Public_File_ID;
            credit = "";
            credit_parts = List();
            if(rec.Job_Name != null && rec.Job_Name != "")
            {
                credit_parts.add(rec.Job_Name);
            }
            if(rec.Installed != null && rec.Installed != "")
            {
                credit_parts.add(rec.Installed);
            }
            if(rec.Sent_By != null && rec.Sent_By != "")
            {
                // An email address or a domain (website photos) is the uploader;
                // a plain name is the crew (from the CRM sync file name).
                if(rec.Sent_By.contains("@") || rec.Sent_By.contains("."))
                {
                    credit_parts.add("photo by " + rec.Sent_By);
                }
                else
                {
                    credit_parts.add("crew: " + rec.Sent_By);
                }
            }
            for each cp in credit_parts
            {
                if(credit != "")
                {
                    credit = credit + " &middot; ";
                }
                credit = credit + cp.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
            }
            headline = "Nailed it.";
            line_text = "Finished work from our crews this week. Nice job, team.";
            alt_text = "Nailed it: photo of recent finished Livewire work.";
            if(image_id != null && image_id != "")
            {
                img_src = "https://drive.google.com/thumbnail?id=" + image_id + "&sz=w1200";
                if(image_id.startsWith("http"))
                {
                    // Website photo (interim source): already a public URL.
                    img_src = image_id;
                }
                // This week's Failed It image. Its own try: a failed listing
                // only drops the left side, never the Nailed It photo.
                failed_id = "";
                try
                {
                    fparams = Map();
                    fparams.put("q", "'" + NAILED_IT_FAILED_FOLDER_ID + "' in parents and trashed = false and mimeType contains 'image/'");
                    fparams.put("fields", "files(id,name)");
                    fparams.put("orderBy", "name");
                    fparams.put("pageSize", "100");
                    fparams.put("supportsAllDrives", "true");
                    fparams.put("includeItemsFromAllDrives", "true");
                    fresp = invokeurl
                    [
                        url: "https://www.googleapis.com/drive/v3/files"
                        type: GET
                        parameters: fparams
                        connection: "google_drive"
                    ];
                    ffiles = fresp.get("files");
                    if(ffiles != null && ffiles.size() > 0)
                    {
                        failed_id = ffiles.get(ws.getWeekOfYear() % ffiles.size()).get("id");
                    }
                }
                catch (failed_err)
                {
                    info "failed it image skipped: " + failed_err;
                    failed_id = "";
                }

                card_open = "<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='width:100%;max-width:600px;background:" + RF_CARD_BG + ";border:1px solid " + RF_CARD_BORDER + ";border-collapse:separate;margin:0 0 16px;'>";
                if(failed_id != null && failed_id != "")
                {
                    failed_headline = "Failed it.";
                    failed_line = "Spotted in the wild. Not one of ours.";
                    failed_alt = "Failed it: a bad install found online, not Livewire work.";
                    verdict_block =
                        card_open +
                        "<tr><td style='padding:12px;'>" +
                        "<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='width:100%;'><tr>" +
                        "<td width='50%' valign='top' style='width:50%;vertical-align:top;border:0;padding:0 6px 0 0;'>" +
                        "<img src='https://drive.google.com/thumbnail?id=" + failed_id + "&sz=w1200' width='282' alt='" + failed_alt + "' style='display:block;width:100%;max-width:282px;height:auto;border:0;'>" +
                        "<p style='margin:10px 0 0;font-family:" + RF_SANS_STACK + ";font-size:18px;line-height:22px;font-weight:700;color:" + RF_INK + ";'>" + failed_headline + "</p>" +
                        "<p style='margin:4px 0 0;font-family:" + RF_SANS_STACK + ";font-size:13px;line-height:18px;color:" + RF_INK + ";'>" + failed_line + "</p>" +
                        "</td>" +
                        "<td width='50%' valign='top' style='width:50%;vertical-align:top;border:0;padding:0 0 0 6px;'>" +
                        "<img src='" + img_src + "' width='282' alt='" + alt_text + "' style='display:block;width:100%;max-width:282px;height:auto;border:0;'>" +
                        "<p style='margin:10px 0 0;font-family:" + RF_SANS_STACK + ";font-size:18px;line-height:22px;font-weight:700;color:" + RF_COPPER + ";'>" + headline + "</p>" +
                        "<p style='margin:4px 0 0;font-family:" + RF_SANS_STACK + ";font-size:13px;line-height:18px;color:" + RF_INK + ";'>" + line_text + "</p>" +
                        "<p style='margin:6px 0 0;font-family:" + RF_SANS_STACK + ";font-size:11px;line-height:14px;color:" + RF_TEXT_SECONDARY + ";'>" + credit + "</p>" +
                        "</td>" +
                        "</tr></table>" +
                        "</td></tr></table>";
                }
                else
                {
                    verdict_block =
                        card_open +
                        "<tr><td style='padding:0;'>" +
                        "<img src='" + img_src + "' width='600' alt='" + alt_text + "' style='display:block;width:100%;max-width:600px;height:auto;border:0;'>" +
                        "</td></tr>" +
                        "<tr><td style='padding:12px 20px 14px;'>" +
                        "<p style='margin:0;font-family:" + RF_SANS_STACK + ";font-size:20px;line-height:24px;font-weight:700;color:" + RF_COPPER + ";'>" + headline + "</p>" +
                        "<p style='margin:4px 0 0;font-family:" + RF_SANS_STACK + ";font-size:14px;line-height:20px;color:" + RF_INK + ";'>" + line_text + "</p>" +
                        "<p style='margin:6px 0 0;font-family:" + RF_SANS_STACK + ";font-size:11px;line-height:14px;color:" + RF_TEXT_SECONDARY + ";'>" + credit + "</p>" +
                        "</td></tr></table>";
                }
            }
        }
    }
    catch (verdict_err)
    {
        info "nailed it card skipped: " + verdict_err;
        verdict_block = "";
        nailed_rec_id = null;
    }

    // Footer totals.
    total_hw_disp = PLACEHOLDER;
    total_ot_disp = PLACEHOLDER;
    total_ahp_disp = PLACEHOLDER;
    total_util_disp = PLACEHOLDER;
    if(!isolved_pending)
    {
        total_hw_disp = rollup.get("total_hours_worked").round(2);
        total_ot_disp = rollup.get("total_ot").round(2);
        total_ahp_disp = rollup.get("total_actual_hours_paid").round(2);
        total_util_disp = (rollup.get("company_utilization") * 100).round(2) + "%";
    }

    html = "<!DOCTYPE html>" +
        "<html><head><meta charset='utf-8'>" +
        "<title>Utilization Actuals for " + week_label + "</title>" +
        "<style>" +
        "body { font-family: " + BRAND_FONT_STACK + "; color: " + BRAND_PRIMARY_COLOR + "; max-width: 880px; margin: 24px auto; padding: 0 16px; }" +
        "h2 { margin-top: 0; font-size: 18px; }" +
        "p { line-height: 1.5; font-size: 14px; }" +
        "table.actuals { border-collapse: collapse; width: 100%; margin-top: 16px; font-size: 13px; }" +
        "table.actuals th, table.actuals td { border: 1px solid " + BRAND_TABLE_BORDER + "; padding: 8px 10px; }" +
        "table.actuals th { background: " + BRAND_TABLE_HEADER_BG + "; text-align: left; font-weight: 600; }" +
        "table.actuals tfoot td { font-weight: 600; background: " + BRAND_TABLE_HEADER_BG + "; }" +
        "</style></head><body>" +
        "<h2>Utilization Actuals for " + week_label + "</h2>" +
        raving_fan_block +
        banner +
        lead_in +
        verdict_block +
        congrats_line +
        "<table class='actuals'><thead><tr>" +
        "<th>Technician</th>" +
        "<th style='text-align:right'>Hours Billed</th>" +
        "<th style='text-align:right'>Hours Worked</th>" +
        "<th style='text-align:right'>OT</th>" +
        "<th style='text-align:right'>Actual Hours Paid</th>" +
        "<th style='text-align:right'>Actual Utilization</th>" +
        "<th style='text-align:right'>Non-Billable Hours</th>" +
        "<th>Notes</th>" +
        "</tr></thead><tbody>" + rows_html + "</tbody>" +
        "<tfoot><tr>" +
        "<td>Total</td>" +
        "<td style='text-align:right'>" + rollup.get("total_billable").round(2) + "</td>" +
        "<td style='text-align:right'>" + total_hw_disp + "</td>" +
        "<td style='text-align:right'>" + total_ot_disp + "</td>" +
        "<td style='text-align:right'>" + total_ahp_disp + "</td>" +
        "<td style='text-align:right'>" + total_util_disp + "</td>" +
        "<td style='text-align:right'>" + rollup.get("total_non_billable").round(2) + "</td>" +
        "<td></td>" +
        "</tr></tfoot></table></body></html>";

    sendmail
    [
        from: EMAIL_SENDER
        to: EMAIL_TO
        subject: "Utilization Actuals for " + week_label
        message: html
    ];

    // Only a photo that actually went out is retired from the pool.
    if(nailed_rec_id != null && verdict_block != "")
    {
        used = Nailed_It_Photos[ID == nailed_rec_id];
        used.Status = "Used";
        if(rollup.get("company_utilization") != null)
        {
            used.Company_Utilization = rollup.get("company_utilization");
        }
    }
}
