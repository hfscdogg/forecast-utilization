void send_actuals_email(Map result)
{
    BRAND_PRIMARY_COLOR = "#222222";
    BRAND_TABLE_BORDER = "#dddddd";
    BRAND_TABLE_HEADER_BG = "#f4f4f4";
    BRAND_PENDING_BG = "#fff8e1";
    BRAND_FONT_STACK = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";
    // Raised from 62.50% per Stacy via Dustin 2026-08-17, Henry approved.
    // Service techs carry a 67.50% target once SERVICE_TECH_NAMES is
    // populated in generate_actuals.dg; until then everyone is at 80%.
    TARGET_PCT_DISPLAY = "80.00%";
    PLACEHOLDER = "&mdash;";

    // Livewire Design System v3.0 tokens for the Raving Fan snapshot block.
    // See docs/Livewire_Design_System.md sections 1.2, 2.3, 2.6.
    RF_SURFACE = "#1A1A1A";
    RF_DEEP = "#0D0D0D";
    RF_TEXT_PRIMARY = "#FFFFFF";
    RF_TEXT_SECONDARY = "#85857A";
    RF_COPPER = "#F7941D";
    RF_SERIF_STACK = "'Fraunces', Georgia, 'Times New Roman', serif";
    RF_SANS_STACK = "'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";
    RAVING_FAN_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vRsQaH6Q29LCTAkbX_t8_yB3cTXLcXt9EUU9OEn8xE8vzla4j8ijx7Wb1exPNAuDUw79_EBil_N2Gfc/pub?output=csv";
    RAVING_FAN_URL = "https://hfscdogg.github.io/raving-fan/";

    EMAIL_TO = "henry@getlivewire.com";
    EMAIL_SENDER = "henry@getlivewire.com";

    techs = result.get("techs");
    rollup = result.get("rollup");
    week_start_str = result.get("week_start");
    week_end_str = result.get("week_end");
    isolved_pending = rollup.get("isolved_pending");

    ws = week_start_str.toDate();
    we = week_end_str.toDate();
    week_label = ws.toString("EEE MMM d") + " to " + we.toString("EEE MMM d");

    // Sort desc by actual_utilization when present, else by hours_billed.
    sorted_techs = List();
    for each r in techs
    {
        inserted = false;
        new_sorted = List();
        r_key = r.get("actual_utilization");
        if(r_key == null)
        {
            if(isolved_pending)
            {
                r_key = r.get("hours_billed");
            }
            else
            {
                // Missing-timecard rows sink below every real percentage.
                r_key = -1;
            }
        }
        for each existing in sorted_techs
        {
            e_key = existing.get("actual_utilization");
            if(e_key == null)
            {
                if(isolved_pending)
                {
                    e_key = existing.get("hours_billed");
                }
                else
                {
                    e_key = -1;
                }
            }
            if(!inserted && r_key > e_key)
            {
                new_sorted.add(r);
                inserted = true;
            }
            new_sorted.add(existing);
        }
        if(!inserted)
        {
            new_sorted.add(r);
        }
        sorted_techs = new_sorted;
    }

    rows_html = "";
    for each r in sorted_techs
    {
        hb = r.get("hours_billed");
        hw = r.get("hours_worked");
        ot = r.get("ot");
        ahp = r.get("actual_hours_paid");
        au = r.get("actual_utilization");
        nbh = r.get("non_billable_hours");

        hb_disp = hb.round(2);
        nbh_disp = nbh.round(2);
        hw_disp = PLACEHOLDER;
        if(hw != null)
        {
            hw_disp = hw.round(2);
        }
        ot_disp = PLACEHOLDER;
        if(ot != null)
        {
            ot_disp = ot.round(2);
        }
        ahp_disp = PLACEHOLDER;
        if(ahp != null)
        {
            ahp_disp = ahp.round(2);
        }
        au_disp = PLACEHOLDER;
        if(au != null)
        {
            au_disp = (au * 100).round(2) + "%";
        }

        notes_parts = List();
        if(r.get("timecard_missing") == true)
        {
            notes_parts.add("timecard missing in iSolved at run time");
        }
        if(r.get("ramp_up") == true)
        {
            notes_parts.add("ramp-up, counts from " + r.get("billable_from"));
        }
        if(nbh > 0)
        {
            notes_parts.add(nbh.round(2) + " non-billable hours");
        }
        if(ot != null && ot > 0)
        {
            notes_parts.add(ot.round(2) + " OT");
        }
        notes_html = "";
        for each p in notes_parts
        {
            if(notes_html != "")
            {
                notes_html = notes_html + "; ";
            }
            notes_html = notes_html + p;
        }

        rows_html = rows_html +
            "<tr>" +
            "<td>" + r.get("technician") + "</td>" +
            "<td style='text-align:right'>" + hb_disp + "</td>" +
            "<td style='text-align:right'>" + hw_disp + "</td>" +
            "<td style='text-align:right'>" + ot_disp + "</td>" +
            "<td style='text-align:right'>" + ahp_disp + "</td>" +
            "<td style='text-align:right'><strong>" + au_disp + "</strong></td>" +
            "<td style='text-align:right'>" + nbh_disp + "</td>" +
            "<td style='font-size:11px;color:#666'>" + notes_html + "</td>" +
            "</tr>";
    }

    // ============================================================
    // Raving Fan snapshot block. Fetches the latest week with a valid
    // Fan Score from the published Google Sheet CSV, renders a
    // Livewire-design-system-compliant block. Silent fail if the
    // fetch errors or no valid row is found.
    // ============================================================
    raving_fan_block = "";
    try
    {
        rf_resp = invokeurl
        [
            url: RAVING_FAN_CSV_URL
            type: GET
        ];
        rf_text = rf_resp + "";
        if(rf_text != null && rf_text != "")
        {
            rf_lines = rf_text.toList("\n");
            rf_target = null;
            for each line in rf_lines
            {
                cells = line.toList(",");
                if(cells.size() >= 7)
                {
                    week_end_cell = cells.get(1).trim();
                    fan_score_cell = cells.get(6).trim();
                    if(week_end_cell.contains("/") && fan_score_cell.matches("^\\d+$"))
                    {
                        rf_target = cells;
                    }
                }
            }
            if(rf_target != null)
            {
                rf_week_end = rf_target.get(1).trim();
                rf_reviews = rf_target.get(2).trim();
                rf_mentions = rf_target.get(3).trim();
                rf_referrals = rf_target.get(4).trim();
                rf_repeat = rf_target.get(5).trim();
                rf_fan_score = rf_target.get(6).trim();

                metric_label_style = "margin:0 0 6px;font-family:" + RF_SANS_STACK + ";font-size:10.5px;letter-spacing:0.24em;text-transform:uppercase;font-weight:600;color:" + RF_TEXT_SECONDARY + ";";
                metric_value_style = "margin:0;font-family:" + RF_SERIF_STACK + ";font-size:32px;line-height:1;font-weight:400;color:" + RF_TEXT_PRIMARY + ";letter-spacing:-0.02em;";
                fan_label_style = "margin:0 0 6px;font-family:" + RF_SANS_STACK + ";font-size:10.5px;letter-spacing:0.24em;text-transform:uppercase;font-weight:600;color:" + RF_COPPER + ";";
                fan_value_style = "margin:0;font-family:" + RF_SERIF_STACK + ";font-size:40px;line-height:1;font-weight:400;color:" + RF_COPPER + ";letter-spacing:-0.02em;";

                raving_fan_block =
                    "<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='600' align='center' style='max-width:600px;width:100%;background:" + RF_SURFACE + ";margin:0 auto;'>" +
                    "<tr><td style='padding:40px 32px;'>" +
                    "<p style='margin:0 0 12px;font-family:" + RF_SANS_STACK + ";font-size:10.5px;letter-spacing:0.24em;text-transform:uppercase;font-weight:600;color:" + RF_COPPER + ";'>Raving Fan Snapshot</p>" +
                    "<h3 style='margin:0 0 28px;font-family:" + RF_SERIF_STACK + ";font-size:28px;line-height:1.05;letter-spacing:-0.02em;font-weight:400;color:" + RF_TEXT_PRIMARY + ";'>Week ending " + rf_week_end + "</h3>" +
                    "<table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='border-collapse:collapse;'>" +
                    "<tr>" +
                    "<td style='padding:8px 4px;text-align:center;vertical-align:top;'>" +
                    "<p style='" + metric_label_style + "'>Reviews</p>" +
                    "<p style='" + metric_value_style + "'>" + rf_reviews + "</p>" +
                    "</td>" +
                    "<td style='padding:8px 4px;text-align:center;vertical-align:top;'>" +
                    "<p style='" + metric_label_style + "'>Mentions</p>" +
                    "<p style='" + metric_value_style + "'>" + rf_mentions + "</p>" +
                    "</td>" +
                    "<td style='padding:8px 4px;text-align:center;vertical-align:top;'>" +
                    "<p style='" + metric_label_style + "'>Referrals</p>" +
                    "<p style='" + metric_value_style + "'>" + rf_referrals + "</p>" +
                    "</td>" +
                    "<td style='padding:8px 4px;text-align:center;vertical-align:top;'>" +
                    "<p style='" + metric_label_style + "'>Repeat</p>" +
                    "<p style='" + metric_value_style + "'>" + rf_repeat + "</p>" +
                    "</td>" +
                    "<td style='padding:8px 4px;text-align:center;vertical-align:top;'>" +
                    "<p style='" + fan_label_style + "'>Fan Score</p>" +
                    "<p style='" + fan_value_style + "'>" + rf_fan_score + "</p>" +
                    "</td>" +
                    "</tr>" +
                    "</table>" +
                    "<table role='presentation' cellpadding='0' cellspacing='0' border='0' align='center' style='margin:32px auto 0;'>" +
                    "<tr><td style='background:" + RF_COPPER + ";border:2px solid " + RF_COPPER + ";border-radius:30px;'>" +
                    "<a href='" + RAVING_FAN_URL + "' style='display:block;padding:14px 32px;color:" + RF_TEXT_PRIMARY + " !important;text-decoration:none !important;font-family:" + RF_SANS_STACK + ";font-size:14px;font-weight:600;letter-spacing:0.02em;'>Open the Scorecard</a>" +
                    "</td></tr>" +
                    "</table>" +
                    "<p style='margin:12px 0 0;font-family:" + RF_SANS_STACK + ";font-size:11px;text-align:center;color:" + RF_TEXT_SECONDARY + ";'>Updated weekly by the Raving Fan team.</p>" +
                    "</td></tr></table>";
            }
        }
    }
    catch (rf_err)
    {
        raving_fan_block = "";
    }

    // Banner and lead-in vary by mode.
    banner = "";
    if(isolved_pending)
    {
        banner = "<p style='background:" + BRAND_PENDING_BG + ";padding:10px 14px;border-left:3px solid #d4a017;font-size:13px;'><strong>iSolved integration pending:</strong> Hours Worked, OT, Actual Hours Paid and Actual Utilization will populate once the iSolved tenant API access is wired. Until then those columns show " + PLACEHOLDER + ". Hours Billed and Non-Billable Hours come straight from CRM and are correct as of this run.</p>";
    }
    else
    {
        missing_techs = rollup.get("timecard_missing_techs");
        if(missing_techs != null && missing_techs.size() > 0)
        {
            missing_joined = "";
            mn = missing_techs.size();
            mi = 0;
            for each mname in missing_techs
            {
                if(mi == 0)
                {
                    missing_joined = mname;
                }
                else if(mi == mn - 1)
                {
                    missing_joined = missing_joined + " and " + mname;
                }
                else
                {
                    missing_joined = missing_joined + ", " + mname;
                }
                mi = mi + 1;
            }
            banner = "<p style='background:" + BRAND_PENDING_BG + ";padding:10px 14px;border-left:3px solid #d4a017;font-size:13px;'><strong>Timecard missing:</strong> " + missing_joined + " had billed hours but no iSolved time when this run fired, so their utilization shows " + PLACEHOLDER + " and they are left out of the company average. Re-run once the time is entered for a corrected number.</p>";
        }
    }

    lead_in = "";
    congrats_line = "";
    if(isolved_pending)
    {
        lead_in = "<p>Last week we billed <strong>" + rollup.get("total_billable").round(2) + "</strong> hours across <strong>" + rollup.get("tech_count") + "</strong> technicians, averaging <strong>" + rollup.get("avg_billable_per_tech").round(2) + "</strong> billable hours per tech. Non-billable hours totalled <strong>" + rollup.get("total_non_billable").round(2) + "</strong>.</p>";
    }
    else
    {
        company_util_pct = (rollup.get("company_utilization") * 100).round(2) + "%";
        lead_in = "<p>Last week we billed <strong>" + rollup.get("total_billable").round(2) + "</strong> hours across <strong>" + rollup.get("tech_count") + "</strong> technicians, averaging <strong>" + rollup.get("avg_billable_per_tech").round(2) + "</strong> billable hours per tech for a company utilization of <strong>" + company_util_pct + "</strong>.</p>";

        above_target = rollup.get("techs_above_target");
        if(above_target.size() == 0)
        {
            congrats_line = "<p>No technician landed above the " + TARGET_PCT_DISPLAY + " target last week.</p>";
        }
        else
        {
            joined = "";
            n = above_target.size();
            i = 0;
            for each name in above_target
            {
                if(i == 0)
                {
                    joined = name;
                }
                else if(i == n - 1)
                {
                    joined = joined + " and " + name;
                }
                else
                {
                    joined = joined + ", " + name;
                }
                i = i + 1;
            }
            congrats_line = "<p>Congrats to <strong>" + joined + "</strong> for being above our " + TARGET_PCT_DISPLAY + " utilization target.</p>";
        }
    }

    // Footer totals.
    total_hw_disp = PLACEHOLDER;
    total_ot_disp = PLACEHOLDER;
    total_ahp_disp = PLACEHOLDER;
    total_util_disp = PLACEHOLDER;
    if(!isolved_pending)
    {
        total_hw_disp = rollup.get("total_hours_worked").round(2);
        total_ot_disp = rollup.get("total_ot").round(2);
        total_ahp_disp = rollup.get("total_actual_hours_paid").round(2);
        total_util_disp = (rollup.get("company_utilization") * 100).round(2) + "%";
    }

    html = "<!DOCTYPE html>" +
        "<html><head><meta charset='utf-8'>" +
        "<title>Utilization Actuals for " + week_label + "</title>" +
        "<style>" +
        "body { font-family: " + BRAND_FONT_STACK + "; color: " + BRAND_PRIMARY_COLOR + "; max-width: 880px; margin: 24px auto; padding: 0 16px; }" +
        "h2 { margin-top: 0; font-size: 18px; }" +
        "p { line-height: 1.5; font-size: 14px; }" +
        "table.actuals { border-collapse: collapse; width: 100%; margin-top: 16px; font-size: 13px; }" +
        "table.actuals th, table.actuals td { border: 1px solid " + BRAND_TABLE_BORDER + "; padding: 8px 10px; }" +
        "table.actuals th { background: " + BRAND_TABLE_HEADER_BG + "; text-align: left; font-weight: 600; }" +
        "table.actuals tfoot td { font-weight: 600; background: " + BRAND_TABLE_HEADER_BG + "; }" +
        "</style></head><body>" +
        "<h2>Utilization Actuals for " + week_label + "</h2>" +
        raving_fan_block +
        banner +
        lead_in +
        congrats_line +
        "<table class='actuals'><thead><tr>" +
        "<th>Technician</th>" +
        "<th style='text-align:right'>Hours Billed</th>" +
        "<th style='text-align:right'>Hours Worked</th>" +
        "<th style='text-align:right'>OT</th>" +
        "<th style='text-align:right'>Actual Hours Paid</th>" +
        "<th style='text-align:right'>Actual Utilization</th>" +
        "<th style='text-align:right'>Non-Billable Hours</th>" +
        "<th>Notes</th>" +
        "</tr></thead><tbody>" + rows_html + "</tbody>" +
        "<tfoot><tr>" +
        "<td>Total</td>" +
        "<td style='text-align:right'>" + rollup.get("total_billable").round(2) + "</td>" +
        "<td style='text-align:right'>" + total_hw_disp + "</td>" +
        "<td style='text-align:right'>" + total_ot_disp + "</td>" +
        "<td style='text-align:right'>" + total_ahp_disp + "</td>" +
        "<td style='text-align:right'>" + total_util_disp + "</td>" +
        "<td style='text-align:right'>" + rollup.get("total_non_billable").round(2) + "</td>" +
        "<td></td>" +
        "</tr></tfoot></table></body></html>";

    sendmail
    [
        from: EMAIL_SENDER
        to: EMAIL_TO
        subject: "Utilization Actuals for " + week_label
        message: html
    ];
}
