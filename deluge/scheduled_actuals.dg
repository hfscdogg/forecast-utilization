void scheduled_actuals()
{
    FAILURE_ALERT_TO = "henry@getlivewire.com";
    FAILURE_ALERT_FROM = "henry@getlivewire.com";

    try
    {
        // The lagging report runs Monday at 4pm ET for the Sun-Sat that
        // ended 9 days ago (a 2-week lag, per the SOP — gives PMs and
        // accounting time to settle hours).
        // Week boundary is Sun-Sat to match Dustin's manual report and the
        // iSolved payroll week (Dustin 2026-08-31: "yours is still doing
        // Monday to Sunday instead of Sunday to Saturday"; supersedes
        // Henry's 2026-08-25 keep-Mon-Sun call — the OT split caps iSolved
        // hours at 40 over this window, so a window offset from the
        // payroll week skews OT and Actual Hours Paid).
        // From today (Monday): lag_week_start = today - 15 (Sunday),
        // lag_week_end = today - 9 (Saturday).
        // The UTC offset is computed per boundary date via eastern_offset
        // so a lag week straddling a DST transition (e.g. Sun Oct 25 to
        // Sat Oct 31) gets the right offset on each edge.
        today = zoho.currenttime.toDate();
        week_start_date = today.subDay(15);
        week_end_date = today.subDay(9);
        week_start_str = week_start_date.toString("yyyy-MM-dd");
        week_end_str = week_end_date.toString("yyyy-MM-dd");
        week_start_iso = week_start_str + "T00:00:00" + thisapp.eastern_offset(week_start_str);
        week_end_iso = week_end_str + "T23:59:59" + thisapp.eastern_offset(week_end_str);

        run_id = zoho.currenttime.toString("yyyyMMddHHmmss") + "-" + randomNumber(1000, 9999);

        // Live iSolved pull (Phase 4b, verified 2026-08-14): Map of
        // Zoho tech full_name -> hours on the clock for the lag week
        // (Hourly Regular + Overtime pay items; PTO and salary excluded).
        // If iSolved errors, the try/catch below alerts Henry — that is
        // the designed failure path, no silent fallback to pending mode.
        time_cards = thisapp.fetch_isolved_timecards(week_start_date.toString("yyyy-MM-dd"), week_end_date.toString("yyyy-MM-dd"));

        result = thisapp.generate_actuals(week_start_iso, week_end_iso, time_cards);
        thisapp.write_actuals_history(result, run_id);
        thisapp.send_actuals_email(result);

        info "Actuals run " + run_id + " complete: " +
            result.get("rollup").get("tech_count") + " techs, " +
            result.get("events_count") + " events, iSolved pending=" +
            result.get("rollup").get("isolved_pending") + ".";
    }
    catch (e)
    {
        sendmail
        [
            from: FAILURE_ALERT_FROM
            to: FAILURE_ALERT_TO
            subject: "Utilization Actuals automation FAILED"
            message: "The scheduled actuals run errored. Trace:\n\n" + e.toString()
        ];
    }
}
