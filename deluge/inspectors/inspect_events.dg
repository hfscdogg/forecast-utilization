// Inline-OAuth inspector — v2 (refresh-token grant).
//
// Covers Events, Users, and Modules in a single pass. Picklist values are
// extracted from the bulk field-metadata response inline, because the
// per-field endpoint (/settings/fields/{name}) needs a finer-grained scope
// that the current refresh token doesn't carry.
//
// Before running: replace REFRESH_TOKEN, CLIENT_ID, CLIENT_SECRET. After
// running once and capturing output, delete this function and rotate the
// Self Client credentials.

void tmp_inspect()
{
    token_resp = invokeurl
    [
        url: "https://accounts.zoho.com/oauth/v2/token"
        type: POST
        parameters: {"grant_type": "refresh_token", "client_id": "CLIENT_ID", "client_secret": "CLIENT_SECRET", "refresh_token": "REFRESH_TOKEN"}
    ];
    info "Scope: " + token_resp.get("scope");
    access_token = token_resp.get("access_token");
    auth_header = {"Authorization": "Zoho-oauthtoken " + access_token};

    fields_meta = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/settings/fields?module=Events"
        type: GET
        headers: auth_header
    ];
    info "=== Events picklist values (Event_Type / Event_Status / Trip_Charge / Helper1 / Service_Plan) ===";
    for each field in fields_meta.get("fields")
    {
        api_name = field.get("api_name");
        if(api_name == "Event_Type" || api_name == "Event_Status" || api_name == "Trip_Charge" || api_name == "Helper1" || api_name == "Service_Plan")
        {
            info api_name + " : " + field.get("pick_list_values").toString();
        }
    }

    sample_events = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/Events?fields=Event_Title,Owner,Helper1,Event_Type,Event_Status,Trip_Charge,Duration_Man_Hrs,Duration_Hrs,Start_DateTime,End_DateTime,Billed,Placeholder,Hours_Logged,Service_Rate,Service_Plan&per_page=1&sort_by=Modified_Time&sort_order=desc"
        type: GET
        headers: auth_header
    ];
    info "=== Sample Event JSON ===";
    info sample_events.toString();

    all_users = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/users?type=ActiveUsers"
        type: GET
        headers: auth_header
    ];
    info "=== Active users count: " + all_users.get("users").size() + " ===";
    info "=== First 2 user records ===";
    count = 0;
    for each u in all_users.get("users")
    {
        if(count < 2)
        {
            info u.toString();
            count = count + 1;
        }
    }

    modules_list = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/settings/modules"
        type: GET
        headers: auth_header
    ];
    info "=== Modules (looking for any custom Technicians module) ===";
    for each m in modules_list.get("modules")
    {
        info m.get("api_name") + " | " + m.get("module_name") + " | generated_type=" + m.get("generated_type");
    }
}
