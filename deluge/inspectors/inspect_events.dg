// Inline-OAuth inspector. Bypasses Creator Connections because the
// curated "ZohoCRM" template doesn't expose the Events module scope.
//
// Before running:
//   Replace REFRESH_TOKEN, CLIENT_ID, CLIENT_SECRET with values from
//   api-console.zoho.com (Self Client). After running this once and
//   capturing the output, delete this function from Creator and rotate
//   the credentials.
//
// Production Deluge code will use a proper Custom Service Connection
// instead of inlining secrets — this script exists only to confirm
// field names and picklist values before the real port.

void tmp_inspect_events()
{
    token_resp = invokeurl
    [
        url: "https://accounts.zoho.com/oauth/v2/token"
        type: POST
        parameters: {"refresh_token": "REFRESH_TOKEN", "client_id": "CLIENT_ID", "client_secret": "CLIENT_SECRET", "grant_type": "refresh_token"}
    ];
    info "Token response: " + token_resp.toString();
    access_token = token_resp.get("access_token");
    auth_header = {"Authorization": "Zoho-oauthtoken " + access_token};

    fields_meta = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/settings/fields?module=Events"
        type: GET
        headers: auth_header
    ];
    info "=== Events module field metadata ===";
    for each field in fields_meta.get("fields")
    {
        info field.get("api_name") + "  |  " + field.get("display_label") + "  |  " + field.get("data_type");
    }

    sample_events = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/Events?per_page=1&sort_by=Modified_Time&sort_order=desc"
        type: GET
        headers: auth_header
    ];
    info "=== Sample Event JSON ===";
    info sample_events.toString();

    event_type_field = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/settings/fields/Event_Type?module=Events"
        type: GET
        headers: auth_header
    ];
    info "=== Event_Type picklist values ===";
    info event_type_field.toString();

    status_field = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/settings/fields/Status?module=Events"
        type: GET
        headers: auth_header
    ];
    info "=== Status picklist values ===";
    info status_field.toString();
}
