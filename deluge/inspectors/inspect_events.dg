void tmp_inspect_events()
{
    // Step 1: list all field API names on the Events module
    fields_meta = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/settings/fields?module=Events"
        type: GET
        connection: "zoho_crm_conn"
    ];
    info "=== Events module field metadata ===";
    for each field in fields_meta.get("fields")
    {
        info field.get("api_name") + "  |  " + field.get("display_label") + "  |  " + field.get("data_type");
    }

    // Step 2: pull one sample event so we see the raw JSON shape
    sample_events = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/Events?per_page=1&sort_by=Modified_Time&sort_order=desc"
        type: GET
        connection: "zoho_crm_conn"
    ];
    info "=== Sample Event JSON ===";
    info sample_events.toString();

    // Step 3: picklist values for Event_Type and Status
    event_type_field = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/settings/fields/Event_Type?module=Events"
        type: GET
        connection: "zoho_crm_conn"
    ];
    info "=== Event_Type picklist values ===";
    info event_type_field.toString();

    status_field = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/settings/fields/Status?module=Events"
        type: GET
        connection: "zoho_crm_conn"
    ];
    info "=== Status picklist values ===";
    info status_field.toString();
}
