void tmp_inspect_users()
{
    // Step 1: list all active users via the built-in users API
    all_users = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/users?type=ActiveUsers"
        type: GET
        connection: "zoho_crm_conn"
    ];
    info "=== Active users (sample of first 3) ===";
    count = 0;
    for each u in all_users.get("users")
    {
        if(count < 3)
        {
            info u.toString();
            count = count + 1;
        }
    }
    info "Total active users returned: " + all_users.get("users").size();

    // Step 2: check if a custom Technicians module exists instead of using built-in users
    modules_list = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/settings/modules"
        type: GET
        connection: "zoho_crm_conn"
    ];
    info "=== All modules (looking for Technicians or similar) ===";
    for each m in modules_list.get("modules")
    {
        info m.get("api_name") + "  |  " + m.get("module_name") + "  |  generated_type=" + m.get("generated_type");
    }
}
