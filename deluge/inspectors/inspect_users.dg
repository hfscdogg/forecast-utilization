// Inline-OAuth inspector for Users / Technicians module.
// See inspect_events.dg header for usage + housekeeping notes.

void tmp_inspect_users()
{
    token_resp = invokeurl
    [
        url: "https://accounts.zoho.com/oauth/v2/token"
        type: POST
        parameters: {"refresh_token": "REFRESH_TOKEN", "client_id": "CLIENT_ID", "client_secret": "CLIENT_SECRET", "grant_type": "refresh_token"}
    ];
    access_token = token_resp.get("access_token");
    auth_header = {"Authorization": "Zoho-oauthtoken " + access_token};

    all_users = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/users?type=ActiveUsers"
        type: GET
        headers: auth_header
    ];
    info "=== Active users (sample of first 3) ===";
    count = 0;
    for each u in all_users.get("users")
    {
        if(count < 3)
        {
            info u.toString();
            count = count + 1;
        }
    }
    info "Total active users returned: " + all_users.get("users").size();

    modules_list = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/settings/modules"
        type: GET
        headers: auth_header
    ];
    info "=== All modules (looking for Technicians or similar) ===";
    for each m in modules_list.get("modules")
    {
        info m.get("api_name") + "  |  " + m.get("module_name") + "  |  generated_type=" + m.get("generated_type");
    }
}
