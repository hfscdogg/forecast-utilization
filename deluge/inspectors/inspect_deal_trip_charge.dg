Map inspect_deal_trip_charge(String week_start, String week_end)
{
    // ROUND 3 (2026-09-07). Round 2 proved What_Id DOES point to Deals
    // ($se_module = "Deals" on all 10 samples, deal names resolve on the
    // event), yet both the Deals COQL (round 1) and the record GET (rounds
    // 1-2) came back empty. Both earlier rounds discarded the error body,
    // so this round returns the RAW responses to name the failure. Leading
    // suspect: the OAuth grant (or the API user's profile) covers Events
    // but not Deals records — field metadata reads through the settings
    // scope, which is why the picklist dump worked anyway. If the raw
    // responses show OAUTH_SCOPE_MISMATCH or NO_PERMISSION, no code change
    // fixes it: the refresh token must be re-minted with a Deals read
    // scope (or the profile granted Deals access).
    token_resp = invokeurl
    [
        url: "https://accounts.zoho.com/oauth/v2/token"
        type: POST
        parameters: {"grant_type": "refresh_token", "client_id": thisapp.Variables.ZOHO_CLIENT_ID, "client_secret": thisapp.Variables.ZOHO_CLIENT_SECRET, "refresh_token": thisapp.Variables.ZOHO_REFRESH_TOKEN}
    ];
    access_token = token_resp.get("access_token");
    auth_header = {"Authorization": "Zoho-oauthtoken " + access_token, "Content-Type": "application/json"};
    auth_header_get = {"Authorization": "Zoho-oauthtoken " + access_token};

    result = Map();

    // 1. Collect a few real deal ids from this week's events.
    q = "SELECT id, What_Id FROM Events WHERE Start_DateTime <= '" + week_end + "' AND End_DateTime >= '" + week_start + "' LIMIT 0, 200";
    body = {"select_query": q};
    resp = invokeurl
    [
        url: "https://www.zohoapis.com/crm/v6/coql"
        type: POST
        parameters: body.toString()
        headers: auth_header
    ];
    events_data = resp.get("data");
    if(events_data == null)
    {
        events_data = List();
    }
    deal_ids = List();
    for each evt in events_data
    {
        w = evt.get("What_Id");
        if(w != null && deal_ids.size() < 3)
        {
            wid = w.get("id").toString();
            if(!deal_ids.contains(wid))
            {
                deal_ids.add(wid);
            }
        }
    }
    result.put("sample_deal_ids", deal_ids);

    if(deal_ids.size() > 0)
    {
        // 2. RAW response of a v6 REST GET on one deal, fields param included.
        raw_get = invokeurl
        [
            url: "https://www.zohoapis.com/crm/v6/Deals/" + deal_ids.get(0) + "?fields=id,Deal_Name,Trip_Charge"
            type: GET
            headers: auth_header_get
        ];
        result.put("deals_rest_get_raw", raw_get);

        // 3. RAW response of the same COQL shape the generators use.
        in_list = "";
        for each did in deal_ids
        {
            if(in_list != "")
            {
                in_list = in_list + ",";
            }
            in_list = in_list + "'" + did + "'";
        }
        dq = "SELECT id, Deal_Name, Trip_Charge FROM Deals WHERE id in (" + in_list + ") LIMIT 0, 10";
        dbody = {"select_query": dq};
        raw_coql = invokeurl
        [
            url: "https://www.zohoapis.com/crm/v6/coql"
            type: POST
            parameters: dbody.toString()
            headers: auth_header
        ];
        result.put("deals_coql_raw", raw_coql);

        // 4. Control: the same REST GET shape against an Events record,
        //    which we know the grant can read — proves the request shape
        //    is right and isolates the difference to the Deals module.
        control_get = invokeurl
        [
            url: "https://www.zohoapis.com/crm/v6/Events/" + events_data.get(0).get("id") + "?fields=id,Event_Type,Trip_Charge"
            type: GET
            headers: auth_header_get
        ];
        result.put("events_rest_get_control_raw", control_get);
    }

    info result;
    return result;
}
