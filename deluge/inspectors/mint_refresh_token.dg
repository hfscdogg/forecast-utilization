Map mint_refresh_token(String grant_code)
{
    // One-off helper for rotating/expanding the CRM OAuth grant (first used
    // 2026-09-07: inspector round 3 confirmed OAUTH_SCOPE_MISMATCH on the
    // Deals module — the original refresh token was minted without a Deals
    // read scope, which blocked the dual trip-charge merge).
    //
    // Usage:
    //   1. api-console.zoho.com -> the existing Self Client (same Client ID
    //      as the ZOHO_CLIENT_ID Creator variable) -> Generate Code with
    //      scopes: ZohoCRM.modules.READ,ZohoCRM.users.READ,ZohoCRM.coql.READ,ZohoCRM.settings.READ
    //      (10-minute validity; pick the production CRM org if prompted).
    //   2. Execute this function with that code as grant_code within 10
    //      minutes.
    //   3. Copy the refresh_token from the output into the Creator App
    //      Variable ZOHO_REFRESH_TOKEN. The old token stays valid until
    //      revoked, so this is zero-downtime and reversible.
    //
    // The output contains a live credential: never commit it, email it, or
    // paste it into anything but the Creator variable. GitGuardian rule
    // applies (docs/decisions.md "Secret leak remediation").
    resp = invokeurl
    [
        url: "https://accounts.zoho.com/oauth/v2/token"
        type: POST
        parameters: {"grant_type": "authorization_code", "client_id": thisapp.Variables.ZOHO_CLIENT_ID, "client_secret": thisapp.Variables.ZOHO_CLIENT_SECRET, "code": grant_code}
    ];
    result = Map();
    result.put("refresh_token", resp.get("refresh_token"));
    result.put("scope_granted", resp.get("scope"));
    result.put("error", resp.get("error"));
    info result;
    return result;
}
